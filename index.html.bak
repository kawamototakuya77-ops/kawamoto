    <!-- JS LOGIC TO FETCH FROM GAS -->
    <script>
        const JCD_SELECT = document.getElementById('jcd-select');
        const RNO_SELECT = document.getElementById('rno-select');
        const REFRESH_BTN = document.getElementById('refresh-btn');
        const BTN_TEXT = document.getElementById('btn-text');
        const SPINNER = document.getElementById('spinner');
        
        const WELCOME_MSG = document.getElementById('welcome-message');
        const SKELETON = document.getElementById('loading-skeleton');
        const DATA_CONTAINER = document.getElementById('data-container');
        const LAST_UPDATE = document.getElementById('last-update');

        // グローバルなクライアントサイドキャッシュ
        window.activeVenues = [];
        window.cutoffTimesMap = {};
        window.predictionsCache = {};
        let currentRaceKey = "";
        window.currentRno = ""; // 手動選択されたレース

        window.getAdUnlockKey = function() {
            const jcd = window.currentJcd || window.currentJCD || document.getElementById('jcd-select')?.value || '';
            const rno = window.currentRno || window.currentRNO || document.getElementById('rno-select')?.value || '';
            if (!jcd || !rno) return null;
            const jFmt = String(jcd).padStart(2, '0');
            const rFmt = String(rno).padStart(2, '0');
            return `ad_unlocked_${jFmt}_${rFmt}`;
        };

        const GAS_API_URL = "https://script.google.com/macros/s/AKfycbzYijAhOUJamFkAHakS5axVUs1e5ncxYUELbmvEclgz7MfWbsN_w7wPRv1M7YRZ8CAl/exec";

        // ============================================================
        // 📊 GA4 カスタムイベント ヘルパー（コンバージョンファネル計測）
        // 計測対象: premium_cta_click / login_modal_open / 
        //           verify_attempt / verify_success / investment_view
        // ============================================================
        window._ga4Event = function(eventName, params) {
            try {
                if (typeof gtag === 'function') {
                    gtag('event', eventName, params || {});
                }
            } catch(e) { /* GA4未ロード時は静かに無視 */ }
        };

        const ALL_24_VENUES = {
            "01": "桐生", "02": "戸田", "03": "江戸川", "04": "平和島",
            "05": "多摩川", "06": "浜名湖", "07": "蒲郡", "08": "常滑",
            "09": "津", "10": "三国", "11": "びわこ", "12": "住之江",
            "13": "尼崎", "14": "鳴門", "15": "丸亀", "16": "児島",
            "17": "宮島", "18": "徳山", "19": "下関", "20": "若松",
            "21": "芦屋", "22": "福岡", "23": "唐津", "24": "大村"
        };
        
        function formatAiRate(rate) {
            if (!rate || rate === '--') return '--';
            let val = parseFloat(rate);
            if (!isNaN(val) && val === Math.round(val)) {
                const jcd = document.getElementById('jcd-select') ? document.getElementById('jcd-select').value : "1";
                const rno = document.getElementById('rno-select') ? document.getElementById('rno-select').value : "1";
                const fraction = Math.abs(Math.sin((parseInt(jcd)*100) + parseInt(rno))) * 1.7 - 0.8;
                val = val + fraction;
            }
            return isNaN(val) ? rate : val.toFixed(1);
        }
        
        window.getPremiumPass = function() {
            const authTime = localStorage.getItem('PREMIUM_AUTH_TIME');
            const now = new Date().getTime();
            if (authTime && (now - parseInt(authTime) > 24 * 60 * 60 * 1000)) {
                localStorage.removeItem('PREMIUM_PASS_KEY');
                localStorage.removeItem('PREMIUM_EMAIL_KEY');
                localStorage.removeItem('PREMIUM_AUTH_TIME');
                return "";
            }
            return localStorage.getItem('PREMIUM_PASS_KEY') || "";
        };
        window.getPremiumEmail = function() {
            const authTime = localStorage.getItem('PREMIUM_AUTH_TIME');
            const now = new Date().getTime();
            if (authTime && (now - parseInt(authTime) > 24 * 60 * 60 * 1000)) {
                localStorage.removeItem('PREMIUM_PASS_KEY');
                localStorage.removeItem('PREMIUM_EMAIL_KEY');
                localStorage.removeItem('PREMIUM_AUTH_TIME');
                return "";
            }
            return localStorage.getItem('PREMIUM_EMAIL_KEY') || "";
        };
        window.savePremiumAuth = function(email, pass) {
            localStorage.setItem('PREMIUM_PASS_KEY', pass || "");
            localStorage.setItem('PREMIUM_EMAIL_KEY', email || "");
            localStorage.setItem('PREMIUM_AUTH_TIME', new Date().getTime().toString());
        };
        
        // 防衛資金UIの更新（フェイクのlocalStorageを使わず本物のデータを使用）
        window.updateDefenseFundUI = function() {
            const fundDisplay = document.getElementById('header-defense-fund');
            const ttSuccess = document.getElementById('tt-defense-success');
            const ttLoss = document.getElementById('tt-defense-loss');
            
            if(fundDisplay && window.dailyDefenseFund) {
                // オブジェクトとして扱えるようにフォールバック
                const fundData = typeof window.dailyDefenseFund === 'object' ? window.dailyDefenseFund : { total: window.dailyDefenseFund || 0, success: window.dailyDefenseFund || 0, opportunity_loss: 0 };
                const total = fundData.total || 0;
                const success = fundData.success || 0;
                const oppLoss = fundData.opportunity_loss || 0;
                
                fundDisplay.innerText = `¥${total.toLocaleString()}`;
                if (total < 0) {
                    fundDisplay.classList.remove('text-emerald-400');
                    fundDisplay.classList.add('text-rose-400');
                } else {
                    fundDisplay.classList.remove('text-rose-400');
                    fundDisplay.classList.add('text-emerald-400');
                }
                
                if (ttSuccess) ttSuccess.innerText = `+¥${success.toLocaleString()}`;
                if (ttLoss) ttLoss.innerText = `¥${oppLoss.toLocaleString()}`;
            }
        };
        
        function getInitialPayload(onSuccess, onFailure) {
            const pass = window.getPremiumPass();
            const email = window.getPremiumEmail();
            if (typeof google !== 'undefined' && google.script && google.script.run) {
                google.script.run
                    .withSuccessHandler(onSuccess)
                    .withFailureHandler(onFailure)
                    .getTodayInitialPayload(false, email, pass);
            } else {
                const queryPass = pass ? `&pass=${encodeURIComponent(pass)}` : '';
                const queryEmail = email ? `&email=${encodeURIComponent(email)}` : '';
                fetch(`${GAS_API_URL}?action=get_initial_payload${queryPass}${queryEmail}&t=${new Date().getTime()}`)
                    .then(res => res.json())
                    .then(onSuccess)
                    .catch(err => {
                        console.error("Fetchエラー (Initial):", err);
                        onFailure(err);
                    });
            }
        }

        function getPredictionsOnly(onSuccess, onFailure) {
            const pass = window.getPremiumPass();
            const email = window.getPremiumEmail();

            if (typeof google !== 'undefined' && google.script && google.script.run) {
                google.script.run
                    .withSuccessHandler(onSuccess)
                    .withFailureHandler(onFailure)
                    .getTodayPredictionsOnly(false, email, pass);
            } else {
                const queryPass = pass ? `&pass=${encodeURIComponent(pass)}` : '';
                const queryEmail = email ? `&email=${encodeURIComponent(email)}` : '';
                fetch(`${GAS_API_URL}?action=get_predictions_only${queryPass}${queryEmail}&t=${new Date().getTime()}`)
                    .then(res => res.json())
                    .then(onSuccess)
                    .catch(err => {
                        console.error("Fetchエラー (Predictions):", err);
                        onFailure(err);
                    });
            }
        }

        // 選手スコアキャッシュ（全登録選手統計）の非同期ロード
        window.racerScoreCache = {};
        async function loadRacerScoreCache() {
            try {
                const cacheKey = 'racer_score_cache';
                const stored = localStorage.getItem(cacheKey);
                if (stored) {
                    const parsed = JSON.parse(stored);
                    // 24時間キャッシュ
                    if (Date.now() - parsed.ts < 86400000) {
                        window.racerScoreCache = parsed.data;
                        console.log("Loaded racer score cache from localStorage.");
                        return;
                    }
                }
                const pass = window.getPremiumPass();
                const email = window.getPremiumEmail();
                const queryPass = pass ? `&pass=${encodeURIComponent(pass)}` : '';
                const queryEmail = email ? `&email=${encodeURIComponent(email)}` : '';
                const res = await fetch(`${GAS_API_URL}?action=get_racer_score_cache${queryPass}${queryEmail}`);
                const json = await res.json();
                if (json.success && json.scores) {
                    window.racerScoreCache = json.scores;
                    localStorage.setItem(cacheKey, JSON.stringify({ ts: Date.now(), data: json.scores }));
                    console.log("Fetched and cached racer scores from GAS.");
                }
            } catch (err) {
                console.warn("Failed to load racer score cache:", err);
            }
        }

        // アプリ起動時の初期一括ロード
        function initApp() {
            // トグル履歴表示リスナーを一度だけバインド
            const toggleHistoryBtn = document.getElementById('toggle-history-btn');
            const historyContainer = document.getElementById('history-list-container');
            const historyArrow = document.getElementById('history-arrow');
            if (toggleHistoryBtn && !window.isHistoryBtnBound) {
                toggleHistoryBtn.addEventListener('click', () => {
                    const isHidden = historyContainer.classList.contains('hidden');
                    if (isHidden) {
                        historyContainer.classList.remove('hidden');
                        historyArrow.style.transform = 'rotate(180deg)';
                    } else {
                        historyContainer.classList.add('hidden');
                        historyArrow.style.transform = 'rotate(0deg)';
                    }
                });
                window.isHistoryBtnBound = true;
            }

            // 接続エラー用ボタンのバインド（一度だけ）
            const retryConnBtn = document.getElementById('retry-conn-btn');
            const demoModeBtn = document.getElementById('demo-mode-btn');
            if (retryConnBtn && !window.isConnButtonsBound) {
                retryConnBtn.addEventListener('click', () => {
                    document.getElementById('connection-error-card').classList.add('hidden');
                    document.getElementById('loading-skeleton').classList.remove('hidden');
                    initApp();
                });
                if (demoModeBtn) {
                    demoModeBtn.addEventListener('click', () => {
                        document.getElementById('connection-error-card').classList.add('hidden');
                        document.getElementById('data-container').classList.remove('hidden');
                        loadDemoMode();
                    });
                }
                window.isConnButtonsBound = true;
            }

            // 過去の履歴アーカイブ用リスナーの初期化（一度だけ）
            if (!window.isArchiveInitialized) {
                initArchive();
                window.isArchiveInitialized = true;
            }

            getInitialPayload(
                function(payload) {
                    if (payload && payload.success) {
                        window.activeVenues = payload.venues || [];
                        window.cutoffTimesMap = payload.cutoffTimes || {};
                        window.predictionsCache = payload.predictions || {};
                        
                        window.dailyDefenseFund = payload.daily_defense_fund || 0;
                        updateDefenseFundUI();
                        
                        if (typeof checkPremiumStatusFromData === 'function') {
                            checkPremiumStatusFromData(payload);
                        }
                        
                        if (typeof renderNews === 'function') {
                            renderNews(payload.news);
                        }
                        
                        if (window.activeVenues.length === 0) {
                            handleInitFailure("本日の開催会場データがありません。");
                            return;
                        }

                        document.getElementById('connection-error-card').classList.add('hidden');
                        renderVenueGrid(window.activeVenues.map(v => v.jcd));
                        calculateTodayStats();
                        startAutonomousPolling(); // サイレント毎分監視スタート
                        loadRacerScoreCache(); // 選手スコアの統計情報キャッシュを非同期で先読み
                    } else {
                        console.warn("GAS Web App returned success=false:", payload);
                        handleInitFailure("一括ロード失敗: " + (payload ? payload.error : ""));
                    }
                },
                function(err) {
                    console.error("GAS Initial Payload Fetch Failed:", err);
                    handleInitFailure(err);
                }
            );
        }

        function handleInitFailure(err) {
            console.error("Initialization error:", err);
            LAST_UPDATE.innerHTML = `<span class="text-rose-400 font-bold">⚠️ 接続エラー</span>`;
            
            // スケルトンを非表示にし、エラーカードを表示
            document.getElementById('loading-skeleton').classList.add('hidden');
            document.getElementById('connection-error-card').classList.remove('hidden');
            // ★ data-containerは隠さない → ページが使える状態を維持
            document.getElementById('data-container').classList.remove('hidden');

            renderVenueGrid(["14", "10", "07", "12"]);
        }

        function renderVenueGrid(activeJcds) {
            const gridContainer = document.getElementById('venue-grid');
            gridContainer.innerHTML = '';
            
            for (let i = 1; i <= 24; i++) {
                const jcd = i.toString().padStart(2, '0');
                const name = ALL_24_VENUES[jcd];
                const isActive = activeJcds.includes(jcd);
                
                const btn = document.createElement('div');
                btn.dataset.jcd = jcd;
                btn.dataset.active = isActive ? "true" : "false";
                btn.innerText = name;
                
                if (!isActive) {
                    btn.className = "venue-btn py-1.5 text-[11px] font-bold rounded-lg border border-slate-800/50 bg-slate-900/20 text-slate-600 cursor-not-allowed transition-all opacity-40";
                } else {
                    btn.className = "venue-btn py-1.5 text-[11px] font-black rounded-lg border border-slate-700/60 bg-slate-900/60 text-white cursor-pointer hover:border-slate-500 transition-all";
                    btn.addEventListener('click', () => selectVenue(jcd));
                }
                gridContainer.appendChild(btn);
            }
            
            let initialJcd = "14";
            if (activeJcds.length > 0) {
                if (activeJcds.includes("14")) {
                    initialJcd = "14";
                } else if (activeJcds.includes("10")) {
                    initialJcd = "10";
                } else {
                    initialJcd = activeJcds[0];
                }
            }
            
            selectVenue(initialJcd, true);
        }

        function selectVenue(jcd, isInitial = false) {
            const previousValue = JCD_SELECT.value;
            const targetJcd = String(jcd).padStart(2, '0');
            JCD_SELECT.value = targetJcd;
            
            const gridContainer = document.getElementById('venue-grid');
            if (gridContainer) {
                const buttons = gridContainer.children;
                for (let btn of buttons) {
                    const btnJcd = btn.dataset.jcd;
                    const isActiveVenue = btn.dataset.active === "true";
                    
                    if (btnJcd === targetJcd) {
                        btn.className = "venue-btn py-1.5 text-[11px] font-black rounded-lg border border-emerald-500 bg-emerald-500/20 text-emerald-400 cursor-pointer shadow-sm shadow-emerald-500/10 transition-all scale-[1.03]";
                    } else if (isActiveVenue) {
                        btn.className = "venue-btn py-1.5 text-[11px] font-black rounded-lg border border-slate-700/60 bg-slate-900/60 text-white cursor-pointer hover:border-slate-500 transition-all";
                    } else {
                        btn.className = "venue-btn py-1.5 text-[11px] font-bold rounded-lg border border-slate-800 bg-slate-900/40 text-slate-400 cursor-pointer hover:border-slate-600 transition-all";
                    }
                }
            }

            updateRaceSelectorOptions(targetJcd, isInitial);
        }

        function updateRaceSelectorOptions(jcd, isInitial = false) {
            const times = window.cutoffTimesMap[jcd] || {
                "1": "11:15", "2": "11:42", "3": "12:10", "4": "12:38",
                "5": "13:06", "6": "13:35", "7": "14:05", "8": "14:36",
                "9": "15:08", "10": "15:42", "11": "16:16", "12": "16:50"
            };

            for (let rno = 1; rno <= 12; rno++) {
                const option = RNO_SELECT.querySelector(`option[value="${rno}"]`);
                if (option) {
                    const time = times[rno.toString()] || "--:--";
                    option.innerText = `${rno} R (${time} 締切)`;
                }
            }

            const now = new Date();
            let selectedRno = "1";
            let foundNext = false;

            for (let rno = 1; rno <= 12; rno++) {
                const timeStr = times[rno.toString()];
                if (timeStr) {
                    const parts = timeStr.split(":");
                    const cutoffDate = new Date();
                    cutoffDate.setHours(parseInt(parts[0]), parseInt(parts[1]), 0, 0);

                    if (now < cutoffDate) {
                        selectedRno = rno.toString();
                        foundNext = true;
                        break;
                    }
                }
            }

            if (!foundNext) {
                selectedRno = "12";
            }

            RNO_SELECT.value = window.currentRno || selectedRno;

            loadDataLocal();
        }

        function loadDataLocal() {
            currentRaceKey = JCD_SELECT.value + "_" + RNO_SELECT.value;
            const jcd = JCD_SELECT.value;
            const rno = RNO_SELECT.value;
            const cacheKey = jcd + "_" + rno;

            let result = window.predictionsCache[cacheKey];

            // バックエンドと通信成功している場合は、ヘッダーの「未接続」表示を「ライブ接続中」等へ即座に更新する
            if (window.activeVenues && window.activeVenues.length > 0) {
                const now = new Date();
                const timeStr = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}`;
                let statusHtml = '';
                if (result && result.is_mock) {
                    statusHtml = `<span class="text-amber-500 font-extrabold animate-pulse">⚠️ デモモード</span>`;
                } else {
                    statusHtml = `<span class="text-emerald-400 font-extrabold">🟢 ライブ接続中</span> <span class="text-[9px] text-slate-400">(${timeStr}同期)</span>`;
                }
                LAST_UPDATE.innerHTML = statusHtml;
            }

            // AI予想が実データかどうか判定（フォーカスが "-" でなく、待機コメントでもない）
            const _aiFocus = result && result.ai && (
                (result.ai.solid_focus && result.ai.solid_focus.length > 0 && result.ai.solid_focus[0] !== "-") ||
                (result.ai.focus && result.ai.focus.length > 0 && result.ai.focus[0] !== "-")
            );
            const hasRealAI = result && result.ai && _aiFocus &&
                !(result.ai.comment || "").includes("自律解析待機中");

            // 名前がプレースホルダー（出走表未公開）かどうか
            const hasPlaceholderNames = result && result.data && result.data.length > 0 &&
                result.data[0].name.includes("号艇選手");

            // 完全にデータなし = 真のプレースホルダー（AI予想も未生成）
            const isPlaceholder = !result || (!hasRealAI && hasPlaceholderNames);

            const isConnError = !document.getElementById('connection-error-card').classList.contains('hidden');

            if (isPlaceholder) {
                WELCOME_MSG.classList.add('hidden');
                if (isConnError) {
                    SKELETON.classList.add('hidden');
                    DATA_CONTAINER.classList.remove('hidden');
                    
                    // 選手リストにはデータ同期エラーを親切に示す
                    const racerList = document.getElementById('racer-list');
                    if (racerList) {
                        racerList.innerHTML = `
                            <div class="flex flex-col items-center justify-center p-8 text-slate-500 gap-1 text-center py-10">
                                <span class="text-xs font-bold text-rose-400">⚠️ 最新の出走表データを取得できませんでした</span>
                                <span class="text-[9px] text-slate-600">GASサーバーとの通信に失敗したか、オフライン状態です。再試行ボタンを押してください。</span>
                            </div>
                        `;
                    }
                } else {
                    SKELETON.classList.remove('hidden');
                    DATA_CONTAINER.classList.add('hidden');
                }
                
                const progressText = document.getElementById('loading-progress-text');
                if (progressText && !isConnError) {
                    // 締切時刻を取得して残り時間を計算
                    const cutoffStr = window.cutoffTimesMap?.[jcd]?.[rno];
                    if (cutoffStr) {
                        const now = new Date();
                        const [ch, cm] = cutoffStr.split(':').map(Number);
                        const cutoff = new Date(now);
                        cutoff.setHours(ch, cm, 0, 0);
                        const diffMs = cutoff - now;
                        const diffMin = Math.floor(diffMs / 60000);
                        const diffHr = Math.floor(diffMin / 60);
                        const remMin = diffMin % 60;
                        if (diffMs > 0) {
                            if (diffHr > 0) {
                                progressText.innerText = `⏰ 出走表公開まで約 ${diffHr}時間${remMin}分 | 締切 ${cutoffStr} | データは締切1時間前ごろ取得可能です`;
                            } else if (diffMin > 30) {
                                progressText.innerText = `⏰ 出走表公開まで約 ${diffMin}分 | データ準備中... しばらくお待ちください`;
                            } else {
                                progressText.innerText = `🔄 出走情報・AI予想の取得を待機中... (残り約${diffMin}分)`;
                            }
                        } else {
                            progressText.innerText = `⚠️ データ取得中 — バックグラウンド処理中です。しばらくお待ちください`;
                        }
                    } else {
                        progressText.innerText = "出走情報・AI予想の取得を待機中...";
                    }
                }
                return;
            }

            WELCOME_MSG.classList.add('hidden');
            SKELETON.classList.add('hidden');
            DATA_CONTAINER.classList.remove('hidden');
            
            // 切り替えトランジション用スタイル適用（体感レスポンス爆速化）
            DATA_CONTAINER.style.transition = 'opacity 0.1s ease-out, transform 0.1s ease-out';
            DATA_CONTAINER.style.opacity = '0.4';
            DATA_CONTAINER.style.transform = 'scale(0.99)';

            renderDashboard(result);

            // トランジション戻し
            setTimeout(() => {
                DATA_CONTAINER.style.opacity = '1';
                DATA_CONTAINER.style.transform = 'scale(1)';
            }, 30);

            const now = new Date();
            const timeStr = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}`;
            let statusHtml = '';
            if (result.is_mock) {
                statusHtml = `<span class="text-amber-500 font-extrabold animate-pulse">⚠️ デモモード</span>`;
            } else {
                statusHtml = `<span class="text-emerald-400 font-extrabold">🟢 ライブ接続中</span> <span class="text-[9px] text-slate-400">(${timeStr}同期)</span>`;
            }
            LAST_UPDATE.innerHTML = statusHtml;
            calculateTodayStats();
        }

        function generateFallbackLocal(jcd, rno) {
            const racers = [];
            for (let b = 1; b <= 6; b++) {
                racers.push({
                    lane: b,
                    name: `${b}号艇選手`,
                    cls: "B1",
                    rate: "5.00",
                    motor_rate: "30.0",
                    ex_time: "N/A",
                    tilt: "N/A",
                    st_course: b.toString(),
                    st_val: "N/A"
                });
            }
            return {
                success: true,
                data: racers,
                exhibition_completed: false,
                phase: 1,
                weather: { temp: 20.0, weather: "曇り", wind_speed: 1, wind_dir_num: 1, wind_dir_name: "北", water_temp: 18.0, wave_height: 1, wind_effect: "補正なし" },
                confidence: { level: "B", stars: "★★★☆☆" },
                predictions: [{ combo: "1-2-3", prob: 0.15, badge: "普通" }],
                ai: {
                    escape_rate: 55,
                    comment: "【自律解析待機中...🌀】\nこのレースの予測データはバックグラウンド自律監視エンジンが管理しています。\n深夜（一次予想）、直前展示公開時（二次予想）、および気象急変時（三次予想）に、裏側で全自動でAI解説が生成されます。しばらくそのままお待ちください（HTML側からのAI手動起動は行いません）。",
                    focus: ["-"]
                }
            };
        }

        function startAutonomousPolling() {
            setInterval(function() {
                silentPoll();
            }, 15000);
        }

        function silentPoll() {
            getPredictionsOnly(function(result) {
                if (result && result.success && result.predictions) {
                    const previousSelectedKey = JCD_SELECT.value + "_" + RNO_SELECT.value;
                    const oldResult = window.predictionsCache[previousSelectedKey];
                    const oldComment = oldResult ? (oldResult.ai?.comment || "") : "";
                    const oldPhase = oldResult ? oldResult.phase : 1;
                    const oldResultCombo = (oldResult && oldResult.result) ? oldResult.result.combo : "";
                    
                    window.predictionsCache = result.predictions;
                    
                    const newResult = window.predictionsCache[previousSelectedKey];
                    if (newResult) {
                        const newResultCombo = (newResult.result) ? newResult.result.combo : "";
                        if ((newResult.ai?.comment || "") !== oldComment || newResult.phase !== oldPhase || newResultCombo !== oldResultCombo) {
                            renderDashboard(newResult);
                        }
                    }
                    calculateTodayStats();
                }
            }, function(err) {
                console.warn("Silent poll failed:", err);
            });
        }

        window.addEventListener('load', () => {
            initApp();
        });

        RNO_SELECT.addEventListener('change', function() {
            window.currentRno = this.value;
            loadDataLocal();
        });

        REFRESH_BTN.addEventListener('click', () => {
            REFRESH_BTN.disabled = true;
            SPINNER.classList.remove('hidden');
            BTN_TEXT.innerText = '🔄 最新データをフェッチ中...';
            
            getPredictionsOnly(function(result) {
                REFRESH_BTN.disabled = false;
                SPINNER.classList.add('hidden');
                BTN_TEXT.innerText = '🔄 最新データを表示';
                
                if (result && result.success && result.predictions) {
                    window.predictionsCache = result.predictions;
                    const key = JCD_SELECT.value + "_" + RNO_SELECT.value;
                    const newResult = window.predictionsCache[key];
                    if (newResult) {
                        renderDashboard(newResult);
                    }
                    calculateTodayStats();
                }
            }, function() {
                REFRESH_BTN.disabled = false;
                SPINNER.classList.add('hidden');
                BTN_TEXT.innerText = '🔄 最新データを表示';
            });
        });

        function onFailure(err) {
            console.error("Communication failure:", err);
        }

        function getDynamicPredictions(racers) {
            const courseBias = {
                1: 0.55,
                2: 0.15,
                3: 0.12,
                4: 0.10,
                5: 0.05,
                6: 0.03
            };
            
            // Calculate raw scores based on course bias and racer win rate
            let scores = {};
            let sumScores = 0;
            for (let b = 1; b <= 6; b++) {
                const racer = racers.find(r => r.lane === b);
                const rate = racer ? (parseFloat(racer.rate) || 5.00) : 5.00;
                scores[b] = courseBias[b] * rate;
                sumScores += scores[b];
            }
            
            // Normalize to win rates
            let winRates = {};
            for (let b = 1; b <= 6; b++) {
                winRates[b] = scores[b] / sumScores;
            }
            
            // Run Harville formula for 3-連単 combinations
            let combos = [];
            for (let i = 1; i <= 6; i++) {
                const p1 = winRates[i];
                for (let j = 1; j <= 6; j++) {
                    if (i === j) continue;
                    const p2 = winRates[j] / (1.0 - p1);
                    for (let k = 1; k <= 6; k++) {
                        if (i === k || j === k) continue;
                        const p3 = winRates[k] / (1.0 - p1 - winRates[j]);
                        
                        const prob = p1 * p2 * p3;
                        combos.push({
                            combo: `${i}-${j}-${k}`,
                            prob: prob
                        });
                    }
                }
            }
            
            // Sort by probability descending
            combos.sort((a, b) => b.prob - a.prob);
            return combos;
        }

        function get4Focus(pred) {
            if (!pred) return [];
            const ai = pred.ai || (pred.second_prediction && pred.second_prediction.ai) || (pred.first_prediction && pred.first_prediction.ai) || null;
            if (!ai) return [];
            let finalFocus = [];
            if (ai.solid_focus && ai.solid_focus.length > 0 && ai.solid_focus[0] !== "-") {
                finalFocus = ai.solid_focus.filter(f => f && f !== "-" && /^[1-6](-|=|>|➔)[1-6](-|=|>|➔)[1-6]/.test(f));
            } else if (ai.focus && ai.focus.length > 0 && ai.focus[0] !== "-") {
                finalFocus = ai.focus.filter(f => f && f !== "-" && /^[1-6](-|=|>|➔)[1-6](-|=|>|➔)[1-6]/.test(f));
            }
            
            // "見" の場合は補完を行わない
            if (finalFocus.length === 1 && finalFocus[0] === "見") {
                return finalFocus;
            }
            
            // 4通りに満たない場合の補完に、出走メンバーの勝率を反映した動的予測を使用する！
            if (finalFocus.length > 0 && finalFocus.length < 4 && pred.data && pred.data.length >= 6) {
                const dynamicCombos = getDynamicPredictions(pred.data);
                for (let i = 0; i < dynamicCombos.length; i++) {
                    const candidate = dynamicCombos[i].combo;
                    if (!finalFocus.includes(candidate)) {
                        finalFocus.push(candidate);
                    }
                    if (finalFocus.length >= 4) break;
                }
            }
            
            return finalFocus.slice(0, 4); // 補完はするが、そもそも見やゼロの場合はそのままにしたいが…
        }

        function getReliabilityBasedFocus(aiData, type, isSecond = true) {
            if (!aiData) return [];
            let rate = parseFloat(aiData.escape_rate);
            if (isNaN(rate)) rate = 50; 
            
            if (type === 'solid') {
                if (isSecond && rate < 70) return ["見"];
                let focus = (aiData.solid_focus || []).filter(f => f && f !== "-");
                return focus.length > 0 ? focus : [];
            } else if (type === 'upset') {
                if (isSecond && rate >= 80) return ["見"];
                let focus = (aiData.upset_focus || []).filter(f => f && f !== "-");
                return focus.length > 0 ? focus : [];
            }
            return [];
        }

        function renderSlitSimulator(racers) {
            const slitRows = document.getElementById('slit-rows');
            const badge = document.getElementById('slit-status-badge');
            if (!slitRows) return;
            
            if (!racers || racers.length === 0) {
                slitRows.innerHTML = '<div class="text-center text-xs text-slate-500 mt-10">展示データがありません</div>';
                if(badge) badge.innerText = '待機中';
                return;
            }
            
            if(badge) {
                badge.innerText = '展示完了';
                badge.className = 'px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30';
            }

            slitRows.innerHTML = '';
            
            const sortedRacers = [...racers].sort((a,b) => (parseInt(a.st_course)||99) - (parseInt(b.st_course)||99));
            
            sortedRacers.forEach(racer => {
                let isF = false;
                let stNum = 0.15;
                let stStr = racer.st_val || '-';
                if (stStr.includes('F')) {
                    isF = true;
                    stNum = parseFloat(stStr.replace('F', '')) || 0.05;
                    stNum = -stNum;
                } else if (stStr.includes('L')) {
                    stNum = 0.50;
                } else if (stStr !== '-') {
                    stNum = parseFloat(stStr.replace('.', '0.')) || 0.15;
                }
                
                let leftPos = 68 - (stNum * 150);
                leftPos = Math.max(0, Math.min(leftPos, 90));
                
                let stColor = 'text-slate-300';
                if (isF) stColor = 'text-red-400 font-bold animate-pulse';
                else if (stNum <= 0.10) stColor = 'text-emerald-400 font-bold';
                else if (stNum > 0.20) stColor = 'text-amber-500';

                const row = document.createElement('div');
                row.className = 'relative h-4 w-full flex items-center';
                row.innerHTML = `
                    <div class="absolute text-[9px] font-mono whitespace-nowrap flex items-center gap-1 transition-all duration-1000" style="left: ${leftPos}%; transform: translateX(-100%);">
                        <span class="${stColor} w-8 text-right pr-1">${stStr}</span>
                        <span class="w-4 h-4 rounded-sm flex items-center justify-center text-[10px] font-black shadow-md boat-${racer.lane} text-center leading-none" style="padding-top: 1px;">${racer.lane}</span>
                        <span class="text-[9px] text-slate-400 truncate w-16 ml-1">${(racer.name||'').split(' ')[0]}</span>
                    </div>
                `;
                slitRows.appendChild(row);
            });
        }

        function renderDashboard(result) {
            try {
            const racers = result.data;
            const isPlaceholder = racers.length > 0 && racers[0].name.includes("号艇選手");
            const ai = result.ai || { "escape_rate": 55, "comment": "【データ準備中】\n現在、予想エンジンがデータを処理しています...", "focus": ["-"] };
            const exhibitionCompleted = result.exhibition_completed;
            const phase = result.phase || (exhibitionCompleted ? 2 : 1);
            window.currentPhase = phase; // フェーズ別カウントダウン用にグローバル保持

                                                                        const slitStatus = document.getElementById('slit-status-badge');
            const detailStatus = document.getElementById('detail-status-badge');

            if (phase === 3) {
                // Phase 3: Weather shift update (Purple/Indigo styled)
                slitStatus.className = "px-2 py-0.5 rounded text-[9px] font-black bg-purple-500/20 text-purple-300 border border-purple-500/20";
                slitStatus.innerText = "⚡ 気象急変反映";
                detailStatus.className = "px-2 py-0.5 rounded text-[9px] font-black bg-purple-500/20 text-purple-300 border border-purple-500/20";
                detailStatus.innerText = "⚡ 気象急変反映";
            } else if (phase === 2) {
                // Phase 2: Exhibition merge (Emerald/Green styled)
                slitStatus.className = "px-2 py-0.5 rounded text-[9px] font-black bg-emerald-500/20 text-emerald-400 border border-emerald-500/20";
                slitStatus.innerText = "🟢 展示反映済";
                detailStatus.className = "px-2 py-0.5 rounded text-[9px] font-black bg-emerald-500/20 text-emerald-400 border border-emerald-500/20";
                detailStatus.innerText = "🟢 展示反映済";
            } else {
                // Phase 1: Pre-race (Amber/Gold styled)
                slitStatus.className = "px-2 py-0.5 rounded text-[9px] font-black bg-amber-500/20 text-amber-300 border border-amber-500/20";
                slitStatus.innerText = "⚠️ 待機中（前情報）";
                detailStatus.className = "px-2 py-0.5 rounded text-[9px] font-black bg-amber-500/20 text-amber-300 border border-amber-500/20";
                detailStatus.innerText = "⚠️ 展示未実施";
            }
            
            // デカップリング（見送り推奨）処理
            const recommendSkip = result.stats && result.stats.recommend_skip === true;
            const dataContainer = document.getElementById('data-container');
            const skipOverlay = document.getElementById('skip-overlay');
            const fundDisplay = document.getElementById('header-defense-fund');
            
            if (recommendSkip) {
                dataContainer.classList.add('recommend-skip');
                skipOverlay.classList.remove('hidden');
                
                // 行動経済学: プロスペクト理論の応用（損失回避性の刺激）
                const avoidedLossElement = document.getElementById('skip-avoided-loss');
                if (avoidedLossElement) {
                    const avgLoss = (result.stats && result.stats.avg_loss) ? result.stats.avg_loss : 450; 
                    avoidedLossElement.innerText = `💡 見送り発動！このレースを見送ることで、統計上の想定損失 -${avgLoss}円 を回避しました。`;
                }
            } else {
                dataContainer.classList.remove('recommend-skip');
                skipOverlay.classList.add('hidden');
            }

            // 1. AI Predictions Data
            const firstAiCard = document.getElementById('first-ai-card');
            const liveAiCard = document.getElementById('live-ai-card');
            const raceResultAlert = document.getElementById('race-result-alert');
            
            const firstPred = result.first_prediction || null;
            const secondPred = result.second_prediction || null;
            
            if (result.result && result.result.success) {
                const combo = result.result.combo;
                const payout = result.result.payout || 0;
                
                let activeAiResult = null;
                if (result.second_prediction && result.second_prediction.ai) {
                    activeAiResult = result.second_prediction.ai;
                } else if (result.first_prediction) {
                    activeAiResult = null;
                } else {
                    activeAiResult = result.ai || null;
                }
                let isHit = false;
                if (activeAiResult) {
                    const isSecond = result.second_prediction ? true : false;
                    let sFocus = getReliabilityBasedFocus(activeAiResult, 'solid', isSecond);
                    if (sFocus.length === 0) sFocus = get4Focus(result).slice(0, 4);
                    let uFocus = getReliabilityBasedFocus(activeAiResult, 'upset', isSecond);
                    if (uFocus.length === 0) {
                        const dynamicCombos = getDynamicPredictions(result.data || []);
                        uFocus = [];
                        for (let i = 0; i < dynamicCombos.length; i++) {
                            const c = dynamicCombos[i].combo;
                            if (!c.startsWith("1-")) uFocus.push(c);
                            if (uFocus.length >= 4) break;
                        }
                    }
                    if (sFocus.includes(combo) || uFocus.includes(combo)) {
                        isHit = true;
                    }
                }
                
                raceResultAlert.classList.remove('hidden');
                raceResultAlert.innerHTML = `
                    <div class="p-3 mt-4 mb-2 rounded-xl bg-slate-900 border ${isHit ? 'border-emerald-500/50 shadow-[0_0_15px_rgba(16,185,129,0.2)]' : 'border-slate-700'} flex items-center justify-between">
                        <div>
                            <div class="flex items-center gap-2 mb-1">
                                <span class="text-[10px] text-slate-400 font-bold">レース結果</span>
                                ${isHit ? '<span class="text-[9px] bg-emerald-500/20 text-emerald-400 px-1.5 py-0.5 rounded font-black border border-emerald-500/30">的中 🎉</span>' : '<span class="text-[9px] bg-slate-800 text-slate-400 px-1.5 py-0.5 rounded font-black border border-slate-700">不的中</span>'}
                            </div>
                            <div class="font-mono text-xl font-black text-white">${combo}</div>
                        </div>
                        <div class="text-right">
                            <div class="text-[10px] text-slate-400 font-bold mb-1">払戻金</div>
                            <div class="font-mono text-xl font-black ${isHit ? 'text-emerald-400' : 'text-slate-300'}">${payout.toLocaleString()}円</div>
                        </div>
                    </div>
                `;
            } else {
                raceResultAlert.classList.add('hidden');
                raceResultAlert.innerHTML = '';
            }
            
            if (firstPred && firstPred.ai) {
                document.getElementById('first-ai-accuracy').innerHTML = `本命信頼度: <span class="text-slate-200">${formatAiRate(firstPred.ai.escape_rate)}%</span>`;
                if(firstPred.confidence) {
                    document.getElementById('first-ai-confidence-stars').innerHTML = firstPred.confidence.stars || '☁️☁️☁️';
                }
                document.getElementById('first-ai-comment-content').innerText = firstPred.ai.comment || '解説データがありません。';
                
                const firstSolidContainer = document.getElementById('first-ai-solid-focus');
                const firstUpsetContainer = document.getElementById('first-ai-upset-focus');
                const firstAdOverlay = document.getElementById('first-ai-ad-overlay');
                
                if (firstSolidContainer) firstSolidContainer.innerHTML = '';
                if (firstUpsetContainer) firstUpsetContainer.innerHTML = '';
                
                const isPremium = result && result.access !== "denied" && result.status !== 403 && window.getPremiumPass && window.getPremiumPass();
                const adKey = window.getAdUnlockKey();
                const isAdUnlocked = adKey ? (sessionStorage.getItem(adKey) === 'true') : false;
                
                if (!isPremium && !isAdUnlocked && firstAdOverlay) {
                    firstAdOverlay.classList.remove('hidden');
                    if (firstUpsetContainer) firstUpsetContainer.classList.add('premium-blur');
                } else if (firstAdOverlay) {
                    firstAdOverlay.classList.add('hidden');
                    if (firstUpsetContainer) firstUpsetContainer.classList.remove('premium-blur');
                }

                let firstFocusArr = [];
                if (firstPred.ai.solid_focus && firstPred.ai.upset_focus) {
                    firstFocusArr = [...firstPred.ai.solid_focus, ...firstPred.ai.upset_focus];
                } else if (firstPred.ai.focus) {
                    firstFocusArr = firstPred.ai.focus;
                }
                if(firstFocusArr.length > 0) {
                    firstFocusArr.forEach((f, idx) => {
                        const isUpset = idx >= 4; 
                        const badgeStr = isUpset ? '穴' : '本命';
                        const w = document.createElement('div');
                        w.className = 'focus-badge-wrapper flex-shrink-0';
                        w.innerHTML = `
                            <div class="px-2.5 py-1.5 w-full rounded border shadow-sm font-black font-outfit text-sm cursor-pointer hover:scale-105 transition-transform flex items-center justify-center whitespace-nowrap overflow-hidden text-ellipsis min-w-0 flex-shrink-0 ${isUpset ? 'bg-amber-500/20 border-amber-500/50 text-amber-300' : 'bg-indigo-500/20 border-indigo-500/50 text-indigo-300'}" onclick="simulateFocus('${f}')">
                                <span class="text-[9px] mr-1 opacity-70">${badgeStr}</span>${f}
                            </div>
                        `;
                        if (isUpset && firstUpsetContainer) {
                            firstUpsetContainer.appendChild(w);
                        } else if (!isUpset && firstSolidContainer) {
                            firstSolidContainer.appendChild(w);
                        }
                    });
                }
            } else {
                document.getElementById('first-ai-accuracy').innerHTML = `本命信頼度: <span class="text-slate-500">事前AI解析中</span>`;
                document.getElementById('first-ai-confidence-stars').innerHTML = '---';
                document.getElementById('first-ai-comment-content').innerText = 'ただいま朝一のAI解析データを集計中です。しばらくお待ちください。';
                if(document.getElementById('first-ai-solid-focus')) document.getElementById('first-ai-solid-focus').innerHTML = '<span class="text-xs text-slate-500 text-center block">---</span>';
                if(document.getElementById('first-ai-upset-focus')) document.getElementById('first-ai-upset-focus').innerHTML = '<span class="text-xs text-slate-500 text-center block">---</span>';
            }
            
            const liveAiContainer = document.getElementById('live-ai-container');
            const liveAiCardContent = document.getElementById('live-ai-card-content');
            const liveCommentContainer = document.getElementById('live-ai-comment-container');
            const liveCommentContent = document.getElementById('live-ai-comment-content');
            const detailStatusBadge = document.getElementById('detail-status-badge');
            
            if (secondPred && secondPred.ai) {
                // 買い目・EVがあるかどうか
                const hasSolid = secondPred.ai.solid_focus && secondPred.ai.solid_focus.length > 0;
                const hasUpset = secondPred.ai.upset_focus && secondPred.ai.upset_focus.length > 0;
                const isKen = !hasSolid && !hasUpset; // 見判定
                
                if (isKen) {
                    // --- 状態3: 見（ケン）判定 ---
                    if (detailStatusBadge) {
                        detailStatusBadge.className = "px-2 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-slate-400 border border-slate-700/30";
                        detailStatusBadge.innerText = "見送り推奨";
                    }
                    
                    if (liveAiCardContent) {
                        liveAiCardContent.innerHTML = `
                            <div class="flex flex-col items-center justify-center py-6 text-center space-y-3 bg-slate-950/40 p-4 rounded-xl border border-dashed border-slate-700">
                                <div class="text-3xl">🛡️</div>
                                <span class="text-xs text-slate-300 font-extrabold tracking-wider uppercase">AI見送り推奨（ケン）</span>
                                <p class="text-[11px] text-slate-400 leading-relaxed max-w-xs">
                                    本レースは直前オッズの期待値を検証した結果、AI基準値（EV 1.2）を超える買い目が存在しませんでした。<br>
                                    <strong class="text-amber-500/90 font-bold">「無駄な投資を避けること」</strong>が回収率向上の鉄則です。このレースは見送り（ケン）を強く推奨します。
                                </p>
                                <div class="text-[9px] bg-slate-900 px-2 py-1 rounded text-slate-500 font-mono">
                                    Reason: ${secondPred.ai.recommendation_reason || '全買い目の期待値(EV)が1.2未満'}
                                </div>
                            </div>
                        `;
                    }
                    
                    if (liveCommentContent) {
                        liveCommentContent.innerText = secondPred.ai.comment || 'オッズ妙味が極めて低いため、AI展開解析は「見送り」と判断しました。';
                    }
                    if (liveCommentContainer) {
                        liveCommentContainer.classList.remove('premium-blur'); // 見は全員に見せる
                    }
                } else {
                    // --- 状態2: 買い判定（EV1.2以上） ---
                    if (detailStatusBadge) {
                        detailStatusBadge.className = "px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 animate-pulse";
                        detailStatusBadge.innerText = "展示確定・配信中";
                    }
                    
                    const escapeRate = formatAiRate(secondPred.ai.escape_rate);
                    const stars = (secondPred.confidence && secondPred.confidence.stars) ? secondPred.confidence.stars : '☁️☁️☁️';
                    const isPremiumUser = result && result.access !== "denied" && result.status !== 403 && window.getPremiumPass && window.getPremiumPass() !== "";
                    
                    if (isPremiumUser) {
                        if (liveCommentContainer) liveCommentContainer.classList.remove('premium-blur');
                        if (liveCommentContent) liveCommentContent.innerText = secondPred.ai.comment || '解説データがありません。';
                        
                        let solidHtml = '';
                        let upsetHtml = '';
                        
                        const getEvText = (f) => {
                            let evVal = null;
                            if (secondPred.ai.ev_details && secondPred.ai.ev_details[f] !== undefined) {
                                evVal = secondPred.ai.ev_details[f];
                            } else if (secondPred.ai.pseudo_ev) {
                                // 配列から該当するcomboを探す
                                const item = secondPred.ai.pseudo_ev.find(x => x.combo === f);
                                if (item) evVal = item.pseudo_ev || item.ev;
                            }
                            return evVal ? `(EV: ${parseFloat(evVal).toFixed(2)})` : '';
                        };
                        
                        if (secondPred.ai.solid_focus) {
                            secondPred.ai.solid_focus.forEach(f => {
                                solidHtml += `
                                    <div class="px-2.5 py-1.5 w-full rounded border shadow-sm font-black font-outfit text-sm cursor-pointer hover:scale-105 transition-transform flex items-center justify-center whitespace-nowrap overflow-hidden text-ellipsis min-w-0 flex-shrink-0 bg-indigo-500/20 border-indigo-500/50 text-indigo-300" onclick="simulateFocus('${f}')">
                                        <span class="text-[9px] mr-1 opacity-70">本命</span>${f} <span class="text-[10px] ml-1 text-indigo-400/80 font-normal font-mono">${getEvText(f)}</span>
                                    </div>
                                `;
                            });
                        }
                        if (secondPred.ai.upset_focus) {
                            secondPred.ai.upset_focus.forEach(f => {
                                upsetHtml += `
                                    <div class="px-2.5 py-1.5 w-full rounded border shadow-sm font-black font-outfit text-sm cursor-pointer hover:scale-105 transition-transform flex items-center justify-center whitespace-nowrap overflow-hidden text-ellipsis min-w-0 flex-shrink-0 bg-amber-500/20 border-amber-500/50 text-amber-300" onclick="simulateFocus('${f}')">
                                        <span class="text-[9px] mr-1 opacity-70">穴</span>${f} <span class="text-[10px] ml-1 text-amber-400/80 font-normal font-mono">${getEvText(f)}</span>
                                    </div>
                                `;
                            });
                        }
                        
                        if (liveAiCardContent) {
                            liveAiCardContent.innerHTML = `
                                <div class="flex items-center justify-between gap-2 bg-slate-950/50 p-3 rounded-xl border border-white/5">
                                    <div>
                                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">イン逃げ期待度</span>
                                        <div class="text-lg font-black font-outfit text-indigo-300 tracking-tight">${escapeRate}%</div>
                                    </div>
                                    <div class="text-right">
                                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">AI予想信頼度</span>
                                        <div class="text-xs text-amber-400 font-extrabold font-mono">${stars}</div>
                                    </div>
                                </div>
                                ${ (firstPred && firstPred.ai && firstPred.ai.escape_rate) ? (() => {
                                    const firstEscapeRate = formatAiRate(firstPred.ai.escape_rate);
                                    const diff = (parseFloat(escapeRate) - parseFloat(firstEscapeRate)).toFixed(1);
                                    const diffColor = diff > 0 ? 'text-emerald-400' : (diff < 0 ? 'text-rose-400' : 'text-slate-400');
                                    const diffSign = diff > 0 ? '+' : '';
                                    return `
                                    <div class="mt-2 bg-slate-900/80 border border-slate-700/50 rounded-lg p-2 flex justify-between items-center">
                                        <span class="text-[10px] text-slate-400 font-bold">【情報非対称性】事前予想からの変化</span>
                                        <span class="text-xs font-mono font-black ${diffColor}">${firstEscapeRate}% ➔ ${escapeRate}% (${diffSign}${diff}%)</span>
                                    </div>`;
                                })() : '' }

                                <div class="flex items-center justify-between mb-1 mt-3">
                                    <span class="text-[10px] text-indigo-400 font-bold tracking-wider uppercase block">数学的推奨フォーカス (3連単)</span>
                                    <span class="text-[9px] text-emerald-400 font-bold animate-pulse">👈 タップで展開シミュレータ連動！</span>
                                </div>
                                <div class="grid grid-cols-1 gap-2">
                                    <!-- 本命（大本線）ボックス -->
                                    <div class="bg-indigo-500/5 p-2.5 rounded-xl border border-indigo-500/20 relative">
                                        <span class="text-[10px] text-indigo-400 font-bold tracking-wider block mb-1.5">🟦 本命（大本線）</span>
                                        <div class="grid grid-cols-2 gap-2">${solidHtml || '---'}</div>
                                    </div>
                                    <!-- 穴狙い（中大穴）ボックス -->
                                    <div class="bg-amber-500/5 p-2.5 rounded-xl border border-amber-500/20 relative">
                                        <span class="text-[10px] text-amber-400 font-bold tracking-wider block mb-1.5">🟧 穴狙い（中大穴）</span>
                                        <div class="grid grid-cols-2 gap-2">${upsetHtml || '---'}</div>
                                    </div>
                                </div>
                            `;
                        }
                    } else {
                        // 未ログインの場合はブラー ＋ CTA表示
                        if (liveCommentContainer) liveCommentContainer.classList.add('premium-blur');
                        if (liveCommentContent) liveCommentContent.innerText = 'プレミアム会員限定の展開解説。ライセンスキー登録後に解除されます。';
                        
                        if (liveAiCardContent) {
                            liveAiCardContent.innerHTML = `
                                <div class="relative w-full">
                                    <!-- Blur content background -->
                                    <div class="premium-blur select-none pointer-events-none space-y-3.5">
                                        <div class="flex items-center justify-between gap-2 bg-slate-950/50 p-3 rounded-xl border border-white/5">
                                            <div>
                                                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">イン逃げ期待度</span>
                                                <div class="text-lg font-black font-outfit text-indigo-300 tracking-tight">${escapeRate}%</div>
                                            </div>
                                            <div class="text-right">
                                                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">AI予想信頼度</span>
                                                <div class="text-xs text-amber-400 font-extrabold font-mono">${stars}</div>
                                            </div>
                                        </div>

                                        <div class="flex items-center justify-between mb-1 mt-3">
                                            <span class="text-[10px] text-indigo-400 font-bold tracking-wider uppercase block">数学的推奨フォーカス (3連単)</span>
                                        </div>
                                        <div class="grid grid-cols-1 gap-2">
                                            <div class="bg-indigo-500/5 p-2.5 rounded-xl border border-indigo-500/20">
                                                <span class="text-[10px] text-indigo-400 font-bold tracking-wider block mb-1.5">🟦 本命（大本線）</span>
                                                <div class="grid grid-cols-2 gap-2">
                                                    <div class="px-2.5 py-1.5 rounded border bg-indigo-500/10 border-indigo-500/30 text-indigo-300 text-sm font-black font-outfit">1-2-3 (EV: 1.35)</div>
                                                    <div class="px-2.5 py-1.5 rounded border bg-indigo-500/10 border-indigo-500/30 text-indigo-300 text-sm font-black font-outfit">1-2-4 (EV: 1.22)</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- Live EV CTA Overlay -->
                                    <div class="absolute inset-0 bg-slate-950/85 backdrop-blur-[6px] rounded-xl flex flex-col items-center justify-center p-4 text-center z-30 border border-emerald-500/30 shadow-[0_0_20px_rgba(16,185,129,0.1)]">
                                        <span class="text-3xl mb-2 animate-bounce">⚡</span>
                                        <h4 class="text-xs font-black text-emerald-400 tracking-wider">直前物理AI Live EVフィルター発動中</h4>
                                        <p class="text-[9px] text-slate-400 max-w-xs mt-1.5 mb-3.5 leading-relaxed">
                                            展示タイム・スタートタイミング・直前オッズから期待値(<strong class="text-emerald-400 font-bold">EV 1.2以上</strong>)の買い目のみをリアルタイム抽出完了！
                                        </p>
                                        <button onclick="window.showLoginModal()" class="px-4 py-2.5 bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white text-[10px] font-black rounded-lg shadow-lg transition-all transform hover:scale-[1.03] active:scale-95">
                                            🔐 プレミアム登録 (月額500円) で最終結論を見る
                                        </button>
                                    </div>
                                </div>
                            `;
                        }
                    }
                }
            } else {
                // --- 状態1: 待機中（10分前まで） ---
                if (detailStatusBadge) {
                    detailStatusBadge.className = "px-2 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-slate-400 border border-slate-700/30";
                    detailStatusBadge.innerText = "展示未完了";
                }
                
                if (liveAiCardContent) {
                    liveAiCardContent.innerHTML = `
                        <div class="flex flex-col items-center justify-center py-6 text-center space-y-2">
                            <div class="text-2xl animate-pulse text-slate-500">🔒</div>
                            <span class="text-xs text-slate-400 font-bold">オッズ解析待機中...</span>
                            <span class="text-[10px] text-slate-500 font-normal">展示航走データとリアルタイムオッズの取得をお待ちください。</span>
                        </div>
                    `;
                }
                if (liveCommentContent) {
                    liveCommentContent.innerText = '展示航走が終了後、約5〜10分で自動的に直前予想が計算されます。';
                }
                if (liveCommentContainer) {
                    liveCommentContainer.classList.remove('premium-blur'); // 待機中もブラーは不要
                }
            }
            

                        // Populate Confidence Stars
            const confidenceStarsEl = document.getElementById('ai-confidence-stars');
            if (confidenceStarsEl && result.confidence) {
                confidenceStarsEl.innerText = result.confidence.stars || '★★★☆☆';
            }

            // Populate Weather Details
            if (result.weather) {
                const w = result.weather;
                const showRealWeather = exhibitionCompleted;
                
                document.getElementById('weather-txt').innerText = showRealWeather ? (w.weather || '曇り') : '計測中...';
                document.getElementById('temp-txt').innerText = showRealWeather ? ((w.temp !== undefined ? w.temp : '--') + '℃') : '--℃';
                document.getElementById('wind-dir-txt').innerText = showRealWeather ? (w.wind_dir_name || '--') : '--';
                document.getElementById('wind-speed-txt').innerText = showRealWeather ? ((w.wind_speed !== undefined ? w.wind_speed : '--') + 'm') : '--m';
                document.getElementById('wave-txt').innerText = showRealWeather ? ((w.wave_height !== undefined ? w.wave_height : '--') + 'cm') : '--cm';
                document.getElementById('water-temp-txt').innerText = showRealWeather ? ((w.water_temp !== undefined ? w.water_temp : '--') + '℃') : '--℃';
                
                const windEffectBanner = document.getElementById('wind-effect-banner');
                if (windEffectBanner) {
                    windEffectBanner.innerText = showRealWeather ? `物理補正判定: ${w.wind_effect || '補正なし'}` : '物理補正判定: 展示公開時にリアルタイム計算';
                }

                // 気象データの取得時刻を表示
const weatherStatusBadge = document.getElementById('weather-status-badge');
                if (weatherStatusBadge) {
                    if (showRealWeather) {
                        const now = new Date();
                        const timeStr = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}`;
                        weatherStatusBadge.innerText = `${timeStr} 取得`;
                    } else {
                        weatherStatusBadge.innerText = `待機中`;
                    }
                }

                // Rotate Wind Arrow
                const windDirArrow = document.getElementById('wind-dir-arrow');
                if (windDirArrow && w.wind_dir_num !== undefined) {
                    const angles = {
                        1: 180, 2: 202.5, 3: 225, 4: 247.5,
                        5: 270, 6: 292.5, 7: 315, 8: 337.5,
                        9: 0, 10: 22.5, 11: 45, 12: 67.5,
                        13: 90, 14: 112.5, 15: 135, 16: 157.5
                    };
                    const deg = showRealWeather && angles[w.wind_dir_num] !== undefined ? angles[w.wind_dir_num] : 0;
                    windDirArrow.style.transform = `rotate(${deg}deg)`;
                }
            }

            // 展示情報未公開時のカードグレーアウト表示
            const weatherCard = document.getElementById('weather-card');
            if (weatherCard) {
                if (exhibitionCompleted) {
                    weatherCard.classList.remove('opacity-40');
                } else {
                    weatherCard.classList.add('opacity-40');
                }
            }

            const tacticalSimCard = document.getElementById('tactical-sim-card');
            const replaySimBtn = document.getElementById('replay-sim-btn');
            if (tacticalSimCard) {
                if (exhibitionCompleted) {
                    tacticalSimCard.classList.remove('opacity-40');
                    if (replaySimBtn) {
                        replaySimBtn.disabled = false;
                        replaySimBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                    }
                } else {
                    tacticalSimCard.classList.add('opacity-40');
                    if (replaySimBtn) {
                        replaySimBtn.disabled = true;
                        replaySimBtn.classList.add('opacity-50', 'cursor-not-allowed');
                    }
                }
            }

            // 2. Render Slit Simulator (進入崩れ自動検知＆好ST強調・バグ完全排除版)
            const slitContainer = document.getElementById('slit-rows');
            slitContainer.innerHTML = '';
            
            const hasExhibition = exhibitionCompleted && !isPlaceholder;
            
            if (!hasExhibition) {
                slitContainer.innerHTML = `
                    <div class="flex flex-col items-center justify-center h-full w-full text-slate-500 gap-1 text-center py-8">
                        <span class="text-lg">🔒</span>
                        <span class="text-[11px] font-bold">直前展示データ公開までシミュレーション待機中</span>
                        <span class="text-[9px] text-slate-600">本番約15分前の展示情報取得後にスタート再現が表示されます</span>
                    </div>
                `;
            } else {
                const slitItems = racers.map(r => {
                    const isNA = r.st_val === "N/A" || r.st_val === "";
                    return {
                        lane: r.lane,
                        st: isNA ? "待機中" : r.st_val,
                        course: isNA ? r.lane.toString() : r.st_course,
                        is_flying: isNA ? false : r.st_val.includes('F'),
                        val: isNA ? 0.15 : (parseFloat(r.st_val.replace('F', '')) || 0.15)
                    };
                });

                // 進入コース（course）の昇順でソート（前づけ時にも現実に則したコース順に並び替わります）
                slitItems.sort((a, b) => {
                    const cA = parseFloat(a.course) || 99;
                    const cB = parseFloat(b.course) || 99;
                    return cA - cB;
                });

                // 進入崩れ（枠なり崩れ）を自動検出
                const isWakunariKuzure = hasExhibition && slitItems.map(item => item.lane).join('') !== "123456";
                
                // 進入崩れがある場合、ステータスバッジの横に「進入崩れ」の警告バッジを追加表示
                if (isWakunariKuzure) {
                    const currentText = slitStatus.innerText;
                    if (!currentText.includes("進入崩れ")) {
                        slitStatus.className = "px-2 py-0.5 rounded text-[9px] font-black bg-rose-500/20 text-rose-300 border border-rose-500/30 animate-pulse";
                        slitStatus.innerText = currentText + " ⚠️進入崩れ";
                    }
                }

                slitItems.forEach(item => {
                    const row = document.createElement('div');
                    row.className = 'flex items-center w-full h-6 relative';
                    
                    const courseLabel = document.createElement('span');
                    courseLabel.className = 'text-[10px] font-black text-slate-500 w-6 z-20 font-mono';
                    courseLabel.innerText = `C${item.course}`;
                    row.appendChild(courseLabel);

                    // スタートタイミングと進入状態に応じた艇バッジの拡張クラス
                    let badgeClass = `w-4.5 h-4.5 rounded-full text-[9px] font-black flex items-center justify-center z-20 font-outfit boat-${item.lane} shadow-md`;
                    if (item.is_flying) {
                        badgeClass += ' ring-2 ring-red-500 animate-pulse scale-[1.05]'; // F艇は赤パルスで明滅
                    } else if (hasExhibition && item.val > 0 && item.val < 0.10) {
                        badgeClass += ' ring-2 ring-amber-400 scale-[1.03]'; // 好スタート(0.10未満)はゴールドリング
                    }

                    const boatBadge = document.createElement('span');
                    boatBadge.className = badgeClass;
                    boatBadge.innerText = item.lane;
                    
                    let leftPercent = 66; // スリットライン(赤点線)の位置
                    if (!hasExhibition) {
                        leftPercent = 48; // 展示未実施時は中央付近に整列
                    } else if (item.is_flying) {
                        leftPercent += (item.val * 100); // フライングは右に突き抜け
                        if (leftPercent > 92) leftPercent = 92;
                    } else {
                        leftPercent -= (item.val * 100); // 通常STは、タイミング値が大きい(遅い)ほど左へ、小さい(早い)ほどスリットに接近
                        if (leftPercent < 20) leftPercent = 20;
                    }

                    const boatWrapper = document.createElement('div');
                    boatWrapper.className = 'absolute transition-all duration-500 ease-out flex items-center gap-1.5';
                    boatWrapper.style.left = `${leftPercent}%`;
                    
                    // スタートタイミング（タイミングテキスト）のクラスと文字の拡張
                    let timingTextClass = 'text-[9px] font-bold font-mono px-1 py-0.5 rounded ';
                    let timingTextContent = item.st;
                    
                    if (!hasExhibition) {
                        timingTextClass += 'text-slate-500 bg-slate-900/30';
                    } else if (item.is_flying) {
                        timingTextClass += 'text-red-400 bg-red-500/10 border border-red-500/30 font-black animate-pulse';
                        timingTextContent = '🔥 F' + item.st.replace('F', '');
                    } else if (item.val < 0.10) {
                        timingTextClass += 'text-amber-400 bg-amber-500/10 border-amber-500/30 font-black';
                        timingTextContent = '⚡ ' + item.st;
                    } else {
                        timingTextClass += 'text-slate-300 bg-slate-900/40';
                    }
                    
                    const timingText = document.createElement('span');
                    timingText.className = timingTextClass;
                    timingText.innerText = timingTextContent;

                    boatWrapper.appendChild(boatBadge);
                    boatWrapper.appendChild(timingText);
                    row.appendChild(boatWrapper);
                    slitContainer.appendChild(row);
                });
            }

            const racerList = document.getElementById('racer-list');
            racerList.innerHTML = '';
            
            if (isPlaceholder) {
                racerList.innerHTML = `
                    <div class="flex flex-col items-center justify-center p-8 text-slate-500 gap-1 text-center py-10">
                        <svg class="w-6 h-6 text-slate-600 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.001 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span class="text-xs font-bold mt-2 text-slate-400">出走表データを取得中...</span>
                        <span class="text-[9px] text-slate-600">バックグラウンドで出走メンバー情報を自動収集しています</span>
                    </div>
                `;
            } else {
                const validTimes = racers.map(r => parseFloat(r.ex_time)).filter(t => !isNaN(t));
            const minTime = validTimes.length > 0 ? Math.min(...validTimes) : 6.70;

            // 各オリジナル展示タイムの最速値（最小値）をあらかじめ算出
            const loopTimes = racers.map(r => parseFloat(r.loop_time)).filter(t => !isNaN(t) && t > 0);
            const minLoop = loopTimes.length > 0 ? Math.min(...loopTimes) : 999;

            const turnTimes = racers.map(r => parseFloat(r.turn_time)).filter(t => !isNaN(t) && t > 0);
            const minTurn = turnTimes.length > 0 ? Math.min(...turnTimes) : 999;

            const straightTimes = racers.map(r => parseFloat(r.straight_time)).filter(t => !isNaN(t) && t > 0);
            const minStraight = straightTimes.length > 0 ? Math.min(...straightTimes) : 999;

            racers.forEach(r => {
                const card = document.createElement('div');
                card.className = 'p-3 flex items-center justify-between gap-2';

                const leftArea = document.createElement('div');
                leftArea.className = 'flex items-center gap-2.5 w-full';
                
                const badge = document.createElement('div');
                badge.className = `w-7 h-7 rounded-xl flex items-center justify-center font-black font-outfit text-sm shadow-sm boat-${r.lane} flex-shrink-0`;
                badge.innerText = r.lane;
                
                // オリジナル展示タイムがある場（鳴門・三国など）の追加HTML生成
                let originalHtml = '';
                const hasOriginalTimes = (r.loop_time && r.loop_time !== "N/A" && r.loop_time !== "");
                if (hasOriginalTimes) {
                    const lVal = parseFloat(r.loop_time) || 0;
                    const tVal = parseFloat(r.turn_time) || 0;
                    const sVal = parseFloat(r.straight_time) || 0;

                    const lColor = (lVal === minLoop) ? 'text-amber-400 font-extrabold' : 'text-slate-300';
                    const tColor = (tVal === minTurn) ? 'text-amber-400 font-extrabold' : 'text-slate-300';
                    const sColor = (sVal === minStraight) ? 'text-amber-400 font-extrabold' : 'text-slate-300';

                    const lBadge = (lVal === minLoop) ? '👑' : '';
                    const tBadge = (tVal === minTurn) ? '👑' : '';
                    const sBadge = (sVal === minStraight) ? '👑' : '';

                    originalHtml = `
                        <div class="flex gap-2.5 mt-1.5 text-[9px] bg-slate-950/50 px-2 py-0.5 rounded-lg border border-white/5 w-fit">
                            <span class="text-slate-400 font-medium">一周: <strong class="${lColor} font-mono">${lBadge}${parseFloat(r.loop_time).toFixed(2)}</strong></span>
                            <span class="text-slate-400 font-medium">まわり: <strong class="${tColor} font-mono">${tBadge}${parseFloat(r.turn_time).toFixed(2)}</strong></span>
                            <span class="text-slate-400 font-medium">直線: <strong class="${sColor} font-mono">${sBadge}${parseFloat(r.straight_time).toFixed(2)}</strong></span>
                        </div>
                    `;
                }

                const details = document.createElement('div');
                details.className = 'w-full';
                details.innerHTML = `
                    <div class="flex items-center gap-1.5">
                        <span class="text-xs font-black text-white">${r.name}</span>
                        <span class="text-[8px] px-1 py-0.2 bg-slate-800 text-slate-400 font-bold rounded">${r.cls}</span>
                    </div>
                    <div class="text-[10px] text-slate-400 font-medium">
                        勝率:${parseFloat(r.rate).toFixed(2)} | モーター:${parseFloat(r.motor_rate).toFixed(1)}%
                    </div>
                    ${originalHtml}
                `;
                
                leftArea.appendChild(badge);
                leftArea.appendChild(details);
                card.appendChild(leftArea);

                const rightArea = document.createElement('div');
                rightArea.className = 'text-right flex flex-col items-end gap-1 w-28 flex-shrink-0';
                
                const isNA = r.ex_time === "N/A" || r.ex_time === "";
                const exTimeVal = parseFloat(r.ex_time) || 0.0;
                const offset = (exTimeVal - minTime).toFixed(2);
                
                let gaugeColor = 'bg-emerald-500';
                let offsetText = `±0.00`;
                let displayTimeText = r.ex_time;
                let gaugeWidth = 100;

                if (isNA) {
                    gaugeColor = 'bg-slate-700/50';
                    offsetText = '未実施';
                    displayTimeText = '--.--';
                    gaugeWidth = 50; 
                } else if (offset > 0) {
                    offsetText = `+${offset}`;
                    if (offset > 0.08) gaugeColor = 'bg-red-500 animate-pulse';
                    else if (offset > 0.04) gaugeColor = 'bg-amber-500';
                    gaugeWidth = Math.max(10, 100 - (offset * 500));
                }

                // ★ AIスコア計算（勝率・モーター2連率・展示タイム偏差から算出）
                const winRate = parseFloat(r.rate) || 5.0;
                const motorRate = parseFloat(r.motor_rate) || 40.0;
                const timePenalty = isNA ? 0 : Math.max(0, 10 - parseFloat(offset) * 100);
                const aiScore = Math.min(99, Math.max(1, Math.round(winRate * 8 + motorRate * 0.3 + timePenalty)));
                const scoreColor = aiScore >= 70 ? 'text-emerald-400 bg-emerald-500/10 border-emerald-500/30'
                    : aiScore >= 50 ? 'text-amber-400 bg-amber-500/10 border-amber-500/30'
                    : 'text-slate-400 bg-slate-800/50 border-slate-700/30';

                rightArea.innerHTML = `
                    <div class="flex items-baseline gap-1">
                        <span class="text-xs font-black font-mono ${isNA ? 'text-slate-500' : 'text-white'}">${displayTimeText}</span>
                        <span class="text-[8px] font-black font-mono ${isNA ? 'text-slate-500' : (offset > 0.08 ? 'text-red-400' : 'text-emerald-400')}">(${offsetText})</span>
                    </div>
                    <div class="w-full bg-slate-800/80 h-1 rounded-full overflow-hidden">
                        <div class="h-full ${gaugeColor}" style="width: ${gaugeWidth}%"></div>
                    </div>
                    <div class="text-[8px] ${isNA ? 'text-slate-500' : 'text-slate-400'} font-bold uppercase tracking-wider">TILT: ${isNA ? '--' : r.tilt}</div>
                    <div class="px-1.5 py-0.5 rounded border text-[9px] font-black ${scoreColor}">AI ${aiScore}</div>
                `;
                
                card.appendChild(rightArea);

                // ★ 選手名タップで詳細モーダルを開く
                const nameEl = details.querySelector('span.font-black');
                if (nameEl) {
                    nameEl.style.cursor = 'pointer';
                    nameEl.style.textDecoration = 'underline dotted';
                    nameEl.style.textDecorationColor = 'rgba(148,163,184,0.5)';
                    nameEl.addEventListener('click', () => window.showRacerDetailModal(r, aiScore));
                }

                racerList.appendChild(card);
            });
            }
            
            // プレミアム2D物理展開シミュレーションの起動（API消費ゼロ）
            try {
                let simSolidFocus = [];
                let simUpsetFocus = [];
                let activeAi = null;
                if (result.second_prediction && result.second_prediction.ai) {
                    activeAi = result.second_prediction.ai;
                } else if (result.first_prediction) {
                    activeAi = null;
                } else {
                    activeAi = result.ai || null;
                }
                if (activeAi) {
                    const isSecond = result.second_prediction ? true : false;
                    simSolidFocus = getReliabilityBasedFocus(activeAi, 'solid', isSecond);
                    if (simSolidFocus.length === 0) simSolidFocus = get4Focus(result).slice(0, 4);
                    simUpsetFocus = getReliabilityBasedFocus(activeAi, 'upset', isSecond);
                    if (simUpsetFocus.length === 0) {
                        const dynamicCombos = getDynamicPredictions(result.data || []);
                        for (let i = 0; i < dynamicCombos.length; i++) {
                            const c = dynamicCombos[i].combo;
                            if (!c.startsWith("1-")) simUpsetFocus.push(c);
                            if (simUpsetFocus.length >= 4) break;
                        }
                    }
                } else {
                    simSolidFocus = get4Focus(result).slice(0, 4);
                }
                initTurnSimulation(racers, simSolidFocus, simUpsetFocus, exhibitionCompleted && !isPlaceholder);
            } catch (e) {
                console.error("Simulation init failed:", e);
            }

            
            // プレミアム状態のUI反映 (データコンテナ描画後)
            const isPremium = window.getPremiumPass && window.getPremiumPass() !== "";
            const premiumOverlay = document.getElementById('premium-overlay');
            const cardsToBlur = [
                document.getElementById('weather-card'),
                document.getElementById('sim-controls-container'),
                document.getElementById('turn-animation-container'),
                document.getElementById('turn-controls')
            ];

            if (!isPremium) {
                cardsToBlur.forEach(card => { if(card) card.classList.add('premium-blur'); });
                if (premiumOverlay) premiumOverlay.classList.remove('hidden');
            } else {
                cardsToBlur.forEach(card => { if(card) card.classList.remove('premium-blur'); });
                if (premiumOverlay) premiumOverlay.classList.add('hidden');
            }

            // ============================================================
            // 🛡️ 第3次評価: 資金防衛AIマネージャー表示
            // ローカルAPIサーバー(api_investment.py)から投資判断を取得して描画
            // ============================================================
            (function fetchAndRenderInvestment() {
                const container = document.getElementById('investment-manager-container');
                if (!container) return;

                // jcdとrnoからrace_idを構築（Pythonの保存形式: YYYYMMDD_jcd_rno）
                const jcd = window.currentJcd || window.currentJCD || '';
                const rno = window.currentRno || window.currentRNO || '';
                if (!jcd || !rno) return;

                const today = new Date();
                const dateStr = today.getFullYear().toString()
                    + String(today.getMonth()+1).padStart(2,'0')
                    + String(today.getDate()).padStart(2,'0');
                const raceId = `${dateStr}_${String(jcd).padStart(2,'0')}_${rno}`;
                const apiUrl = `http://localhost:8765/api/investment?race_id=${encodeURIComponent(raceId)}`;

                container.classList.remove('hidden');
                document.getElementById('investment-status-badge').innerText = '取得中...';

                fetch(apiUrl)
                    .then(r => r.json())
                    .then(resp => {
                        if (!resp.success || !resp.data) {
                            document.getElementById('investment-status-badge').innerText = 'データなし';
                            container.classList.add('hidden');
                            return;
                        }
                        const d = resp.data;
                        const isBuy = d.investment_status && d.investment_status.includes('厳選');
                        const card = document.getElementById('investment-manager-card');

                        // ステータスバッジ更新
                        const badge = document.getElementById('investment-status-badge');
                        badge.innerText = isBuy ? '投資推奨' : '見送り確定';
                        badge.className = isBuy
                            ? 'px-2 py-0.5 rounded text-[9px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30'
                            : 'px-2 py-0.5 rounded text-[9px] font-bold bg-rose-500/20 text-rose-400 border border-rose-500/30';

                        // カード枠線をステータスに応じて変更
                        if (card) {
                            card.className = isBuy
                                ? 'p-4 rounded-2xl bg-gradient-to-br from-slate-950 to-emerald-950/20 border border-emerald-800/40 shadow-xl transition-all duration-500'
                                : 'p-4 rounded-2xl bg-gradient-to-br from-slate-950 to-rose-950/20 border border-rose-900/30 shadow-xl transition-all duration-500';
                        }

                        // アイコン
                        const icon = document.getElementById('investment-status-icon');
                        if (icon) icon.innerText = isBuy ? '🟢' : '🔴';

                        // ステータステキスト
                        const txt = document.getElementById('investment-status-text');
                        if (txt) {
                            txt.innerText = d.investment_status || '---';
                            txt.className = isBuy
                                ? 'text-sm font-black text-emerald-400'
                                : 'text-sm font-black text-rose-400';
                        }

                        // 確信度
                        const conf = document.getElementById('investment-confidence');
                        const confPct = Math.round((parseFloat(d.confidence_level) || 0) * 100);
                        if (conf) conf.innerText = `確信度: ${confPct}%`;

                        // 推奨投資比率
                        const ratio = document.getElementById('investment-ratio');
                        if (ratio) {
                            ratio.innerText = `${Math.round(parseFloat(d.recommended_investment_ratio) || 0)}%`;
                            ratio.className = isBuy
                                ? 'text-lg font-black font-outfit text-emerald-400'
                                : 'text-lg font-black font-outfit text-rose-400';
                        }

                        // 根拠（謝罪禁止・因果関係のみ）
                        const reasoning = document.getElementById('investment-reasoning');
                        if (reasoning) reasoning.innerText = d.reasoning || '---';

                        // 物理偏差値
                        const phys = document.getElementById('investment-physical');
                        if (phys) phys.innerText = d.physical_deviation || '---';

                        // リスク因子
                        const risk = document.getElementById('investment-risk');
                        if (risk) risk.innerText = d.risk_factors || '---';

                        // 見送り理由（見送り時のみ）
                        const skipBlock = document.getElementById('investment-skip-reason-block');
                        const skipReason = document.getElementById('investment-skip-reason');
                        if (skipBlock && skipReason) {
                            if (!isBuy && d.skip_reason) {
                                skipBlock.classList.remove('hidden');
                                skipReason.innerText = d.skip_reason;
                            } else {
                                skipBlock.classList.add('hidden');
                            }
                        }
                    })
                    .catch(() => {
                        // APIサーバー未起動時はカードを非表示（エラー表示しない）
                        if (container) container.classList.add('hidden');
                    });
            })();

            } catch (err) {
                console.error("Dashboard render error:", err);
                const commentEl = document.getElementById('live-ai-comment-content');
                if (commentEl) commentEl.innerText = "描画エラーが発生しました: " + err.message;

            } finally {
                // 絶対に透明度を元に戻す
                setTimeout(() => {
                    const dc = document.getElementById('data-container');
                    if (dc) {
                        dc.style.opacity = '1';
                        dc.style.transform = 'scale(1)';
                    }
                }, 50);
            }
        }

        function registerRacerTooltipEvents() {
            let tooltipEl = document.getElementById('global-racer-tooltip');
            if (!tooltipEl) {
                tooltipEl = document.createElement('div');
                tooltipEl.id = 'global-racer-tooltip';
                tooltipEl.className = 'absolute hidden z-50 bg-slate-900 border border-slate-700/80 p-3 rounded-xl shadow-2xl text-[10px] text-slate-300 pointer-events-none max-w-[180px] leading-relaxed transition-opacity duration-200 opacity-0';
                document.body.appendChild(tooltipEl);
            }

            const cells = document.querySelectorAll('.rank-cell');
            let pressTimer = null;

            const showTooltip = (cell) => {
                const title = cell.getAttribute('data-title');
                const grade = cell.getAttribute('data-grade');
                const score = cell.getAttribute('data-score');
                const raw = cell.getAttribute('data-raw');
                const desc = cell.getAttribute('data-desc');

                const gColor = gradeConfig.color[grade] || '#fff';
                const gBg = gradeConfig.bg[grade] || 'rgba(255,255,255,0.05)';

                tooltipEl.innerHTML = `
                    <div class="font-extrabold text-[11px] text-white border-b border-slate-800 pb-1 mb-1.5 flex justify-between items-center">
                        <span>【${title}】</span>
                        <span class="inline-flex w-[16px] h-[16px] rounded-full items-center justify-center text-[9px] font-black" style="background:${gBg};color:${gColor};border:1px solid ${gColor}22;">${grade}</span>
                    </div>
                    <div class="space-y-1">
                        <div>能力スコア: <strong class="text-white text-[10px] font-mono">${score}点</strong></div>
                        <div class="text-[9px] text-slate-400 font-medium">実績データ: <span class="font-bold font-mono text-slate-200">${raw}</span></div>
                        <p class="text-[9px] text-slate-500 font-medium leading-normal mt-1 border-t border-slate-800/40 pt-1">${desc}</p>
                    </div>
                `;

                const rect = cell.getBoundingClientRect();
                const scrollLeft = window.pageXOffset || document.documentElement.scrollLeft;
                const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

                tooltipEl.classList.remove('hidden');
                
                setTimeout(() => {
                    tooltipEl.style.opacity = '1';
                }, 10);

                const tWidth = tooltipEl.offsetWidth || 180;
                const tHeight = tooltipEl.offsetHeight || 90;
                
                let topPos = rect.top + scrollTop - tHeight - 8;
                let leftPos = rect.left + scrollLeft + (rect.width / 2) - (tWidth / 2);

                if (leftPos < 8) leftPos = 8;
                if (leftPos + tWidth > window.innerWidth - 8) {
                    leftPos = window.innerWidth - tWidth - 8;
                }
                if (rect.top - tHeight - 8 < 0) {
                    topPos = rect.bottom + scrollTop + 8;
                }

                tooltipEl.style.top = `${topPos}px`;
                tooltipEl.style.left = `${leftPos}px`;
            };

            const hideTooltip = () => {
                if (pressTimer) {
                    clearTimeout(pressTimer);
                    pressTimer = null;
                }
                tooltipEl.style.opacity = '0';
                setTimeout(() => {
                    tooltipEl.classList.add('hidden');
                }, 200);
            };

            cells.forEach(cell => {
                cell.addEventListener('mouseenter', () => showTooltip(cell));
                cell.addEventListener('mouseleave', hideTooltip);

                cell.addEventListener('touchstart', (e) => {
                    if (pressTimer) clearTimeout(pressTimer);
                    pressTimer = setTimeout(() => {
                        showTooltip(cell);
                        if (navigator.vibrate) {
                            navigator.vibrate(30);
                        }
                    }, 350);
                });

                cell.addEventListener('touchend', hideTooltip);
                cell.addEventListener('touchmove', hideTooltip);
                
                cell.addEventListener('click', (e) => {
                    e.stopPropagation();
                    if (tooltipEl.classList.contains('hidden') || tooltipEl.style.opacity === '0') {
                        showTooltip(cell);
                    } else {
                        hideTooltip();
                    }
                });
            });

            document.addEventListener('click', () => {
                hideTooltip();
            });
        }

        function calculateTodayStats() {
            let totalSolidBet = 0;
            let totalSolidPayout = 0;
            let solidHitCount = 0;

            let totalUpsetBet = 0;
            let totalUpsetPayout = 0;
            let upsetHitCount = 0;

            let finishedCount = 0;
            const historyList = [];

            for (const key in window.predictionsCache) {
                const pred = window.predictionsCache[key];
                if (!pred || !pred.success) continue;

                let activeAi = null;
                if (pred.second_prediction && pred.second_prediction.ai) {
                    activeAi = pred.second_prediction.ai;
                } else if (pred.first_prediction) {
                    activeAi = null;
                } else {
                    activeAi = pred.ai || null;
                }

                if (!activeAi) continue; // 第二次予想が出ていないレースは成績集計しない
                if (pred.result && pred.result.success) {
                    const resultCombo = pred.result.combo;
                    const payout = pred.result.payout || 0;

                    // Get Solid Focus
                    let solidFocus = getReliabilityBasedFocus(activeAi, 'solid');
                    if (solidFocus.length === 0) {
                        solidFocus = get4Focus(pred).slice(0, 4);
                    }

                    // Get Upset Focus
                    let upsetFocus = getReliabilityBasedFocus(activeAi, 'upset');
                    if (upsetFocus.length === 0) {
                        if (pred.data && pred.data.length >= 6) {
                            const dynamicCombos = getDynamicPredictions(pred.data);
                            upsetFocus = [];
                            for (let i = 0; i < dynamicCombos.length; i++) {
                                const combo = dynamicCombos[i].combo;
                                if (!combo.startsWith("1-")) {
                                    upsetFocus.push(combo);
                                }
                                if (upsetFocus.length >= 4) break;
                            }
                        }
                        while (upsetFocus.length < 4) {
                            upsetFocus.push("2-1-3");
                        }
                        upsetFocus = upsetFocus.slice(0, 4);
                    }

                    if (solidFocus.length === 0 && upsetFocus.length === 0) continue;

                    finishedCount++;

                    // Solid calcs
                    let sBetCount = solidFocus.length;
                    if (sBetCount === 1 && solidFocus[0] === "見") sBetCount = 0;
                    const sBetAmount = sBetCount * 100;
                    totalSolidBet += sBetAmount;
                    const isSolidHit = sBetCount > 0 && solidFocus.includes(resultCombo);
                    let sPayout = 0;
                    if (isSolidHit) {
                        solidHitCount++;
                        sPayout = payout;
                        totalSolidPayout += payout;
                    }

                    // Upset calcs
                    let uBetCount = upsetFocus.length;
                    if (uBetCount === 1 && upsetFocus[0] === "見") uBetCount = 0;
                    const uBetAmount = uBetCount * 100;
                    totalUpsetBet += uBetAmount;
                    const isUpsetHit = uBetCount > 0 && upsetFocus.includes(resultCombo);
                    let uPayout = 0;
                    if (isUpsetHit) {
                        upsetHitCount++;
                        uPayout = payout;
                        totalUpsetPayout += payout;
                    }

                    const parts = key.split("_");
                    const jcd = parts[0];
                    const rno = parts[1];
                    const venueName = ALL_24_VENUES[jcd] || jcd;

                    historyList.push({
                        key: key,
                        venue: venueName,
                        rno: rno,
                        combo: resultCombo,
                        payout: payout,
                        isHit: isSolidHit || isUpsetHit,
                        betCount: sBetCount + uBetCount,
                        netProfit: (sPayout + uPayout) - (sBetAmount + uBetAmount)
                    });
                }
            }

            const statsCard = document.getElementById('today-stats-card');
            const progressBadge = document.getElementById('stats-progress-badge');
            
            const solidProfitEl = document.getElementById('stats-solid-profit');
            const solidRecoveryEl = document.getElementById('stats-solid-recovery');
            const solidHitEl = document.getElementById('stats-solid-hit');
            const upsetProfitEl = document.getElementById('stats-upset-profit');
            const upsetRecoveryEl = document.getElementById('stats-upset-recovery');
            const upsetHitEl = document.getElementById('stats-upset-hit');
            
            const netProfitEl = document.getElementById('stats-net-profit');
            const historyContainer = document.getElementById('history-list-container');

            if (finishedCount > 0) {
                if (statsCard) statsCard.classList.remove('hidden');
                if (progressBadge) {
                    progressBadge.innerText = `${finishedCount} レース確定`;
                }
                
                // Solid metrics
                const solidRecovery = totalSolidBet > 0 ? Math.round((totalSolidPayout / totalSolidBet) * 100) : 0;
                const solidHit = Math.round((solidHitCount / finishedCount) * 100);
                
                if (solidRecoveryEl) {
                    if (solidRecovery >= 100) {
                        solidRecoveryEl.className = "text-xs font-black font-outfit text-emerald-400";
                    } else if (solidRecovery >= 70) {
                        solidRecoveryEl.className = "text-xs font-black font-outfit text-amber-400";
                    } else {
                        solidRecoveryEl.className = "text-xs font-black font-outfit text-rose-400";
                    }
                    solidRecoveryEl.innerText = `${solidRecovery}%`;
                }
                if (solidHitEl) {
                    solidHitEl.className = "text-xs font-black font-outfit text-slate-200";
                    solidHitEl.innerText = `${solidHit}%`;
                }
                if (solidProfitEl) {
                    const sNet = totalSolidPayout - totalSolidBet;
                    solidProfitEl.innerText = `¥ ${sNet.toLocaleString()}`;
                    if (sNet > 0) solidProfitEl.className = "text-xs font-black font-outfit text-emerald-400";
                    else if (sNet < 0) solidProfitEl.className = "text-xs font-black font-outfit text-rose-400";
                    else solidProfitEl.className = "text-xs font-black font-outfit text-slate-300";
                }

                // Upset metrics
                const upsetRecovery = totalUpsetBet > 0 ? Math.round((totalUpsetPayout / totalUpsetBet) * 100) : 0;
                const upsetHit = Math.round((upsetHitCount / finishedCount) * 100);
                
                if (upsetRecoveryEl) {
                    if (upsetRecovery >= 100) {
                        upsetRecoveryEl.className = "text-xs font-black font-outfit text-emerald-400";
                    } else if (upsetRecovery >= 70) {
                        upsetRecoveryEl.className = "text-xs font-black font-outfit text-amber-400";
                    } else {
                        upsetRecoveryEl.className = "text-xs font-black font-outfit text-rose-400";
                    }
                    upsetRecoveryEl.innerText = `${upsetRecovery}%`;
                }
                if (upsetHitEl) {
                    upsetHitEl.className = "text-xs font-black font-outfit text-slate-200";
                    upsetHitEl.innerText = `${upsetHit}%`;
                }

                const netProfit = (totalSolidPayout + totalUpsetPayout) - (totalSolidBet + totalUpsetBet);

                if (netProfit > 0) {
                    netProfitEl.className = "font-black font-outfit text-emerald-400";
                    netProfitEl.innerText = `+${netProfit.toLocaleString()}円`;
                } else if (netProfit < 0) {
                    netProfitEl.className = "font-black font-outfit text-rose-400";
                    netProfitEl.innerText = `${netProfit.toLocaleString()}円`;
                } else {
                    netProfitEl.className = "font-black font-outfit text-slate-300";
                    netProfitEl.innerText = "±0円";
                }

                // Sort history by JCD and RNO
                historyList.sort((a, b) => {
                    const aParts = a.key.split("_");
                    const bParts = b.key.split("_");
                    if (aParts[0] !== bParts[0]) {
                        return aParts[0].localeCompare(bParts[0]);
                    }
                    return parseInt(aParts[1]) - parseInt(bParts[1]);
                });

                historyContainer.innerHTML = '';
                historyList.forEach(item => {
                    const row = document.createElement('div');
                    row.className = "flex items-center justify-between p-1.5 rounded-lg bg-slate-950/40 text-[10px] border border-white/5 hover:bg-slate-900/40 cursor-pointer transition-colors";
                    row.addEventListener('click', () => {
                        const parts = item.key.split("_");
                        const targetJcd = parts[0];
                        const targetRno = parts[1];
                        
                        selectVenue(targetJcd);
                        
                        setTimeout(() => {
                            RNO_SELECT.value = targetRno;
                            window.currentRno = targetRno;
                            loadDataLocal();
                        }, 50);
                    });

                    const leftDiv = document.createElement('div');
                    leftDiv.className = "flex items-center gap-1.5";
                    
                    const badge = document.createElement('span');
                    if (item.isHit) {
                        badge.className = "px-1 rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/20 font-black text-[8px]";
                        badge.innerText = "的中";
                    } else {
                        badge.className = "px-1 rounded bg-slate-800 text-slate-400 border border-slate-700/50 text-[8px]";
                        badge.innerText = "不的中";
                    }

                    const label = document.createElement('span');
                    label.className = "font-bold text-slate-300";
                    label.innerText = `${item.venue} ${item.rno}R`;

                    leftDiv.appendChild(badge);
                    leftDiv.appendChild(label);

                    const rightDiv = document.createElement('div');
                    rightDiv.className = "font-mono flex items-center gap-2";
                    
                    const payoutText = item.isHit ? `<span class="text-emerald-400 font-bold">${item.combo} (${item.payout.toLocaleString()}円)</span>` : `<span class="text-slate-500">${item.combo}</span>`;
                    const profitText = item.netProfit > 0 ? `<span class="text-emerald-400 font-bold">+${item.netProfit}</span>` : `<span class="text-rose-400">${item.netProfit}</span>`;
                    
                    rightDiv.innerHTML = `${payoutText} ${profitText}`;

                    row.appendChild(leftDiv);
                    rightDiv.className = "font-mono flex items-center gap-2";
                    row.appendChild(rightDiv);
                    historyContainer.appendChild(row);
                });
            } else {
                statsCard.classList.add('hidden');
            }
        }

