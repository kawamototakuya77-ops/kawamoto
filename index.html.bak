        function createPremiumFocusElement(focusStr) {
            const container = document.createElement('div');
            container.className = 'flex items-center gap-1';
            
            const tokens = [];
            let currentToken = '';
            
            for (let char of focusStr) {
                if (char === '-' || char === '=' || char === '➔' || char === '>') {
                    if (currentToken) {
                        tokens.push(currentToken);
                        currentToken = '';
                    }
                    tokens.push(char);
                } else {
                    currentToken += char;
                }
            }
            if (currentToken) {
                tokens.push(currentToken);
            }
            
            tokens.forEach(token => {
                if (['-', '=', '➔', '>'].includes(token)) {
                    const arrow = document.createElement('span');
                    arrow.className = 'text-[9px] font-black text-slate-500 font-mono mx-0.5';
                    arrow.innerText = token === '=' ? '⇄' : '➔';
                    container.appendChild(arrow);
                } else {
                    const nums = token.replace(/[^1-6]/g, '').split('');
                    
                    if (nums.length > 1) {
                        const multiBox = document.createElement('div');
                        multiBox.className = 'flex items-center gap-0.5 bg-slate-900/80 px-1 py-0.5 rounded-lg border border-white/5';
                        nums.forEach((num, idx) => {
                            const badge = createBoatBadge(num, 'w-4 h-4 text-[9px]');
                            multiBox.appendChild(badge);
                            if (idx < nums.length - 1) {
                                const slash = document.createElement('span');
                                slash.className = 'text-[8px] text-slate-600 font-bold';
                                slash.innerText = '/';
                                multiBox.appendChild(slash);
                            }
                        });
                        container.appendChild(multiBox);
                    } else if (nums.length === 1) {
                        const badge = createBoatBadge(nums[0], 'w-5 h-5 text-[10px]');
                        container.appendChild(badge);
                    } else {
                        const textSpan = document.createElement('span');
                        textSpan.className = 'text-xs font-black text-slate-300';
                        textSpan.innerText = token;
                        container.appendChild(textSpan);
                    }
                }
            });
            
            return container;
        }

        function createBoatBadge(laneNum, sizeClass = 'w-5 h-5 text-[10px]') {
            const badge = document.createElement('div');
            badge.className = `${sizeClass} rounded-full font-black flex items-center justify-center font-outfit shadow-md flex-shrink-0 boat-${laneNum}`;
            badge.innerText = laneNum;
            return badge;
        }

        // ==========================================
        // プレミアム2D 1マーク物理展開シミュレーター
        // ==========================================
        function initTurnSimulation(racers, solidFocus, upsetFocus, hasExhibitionData) {
            const canvas = document.getElementById('turn-sim-canvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            if (!ctx) return;

            // 二重起動防止：既存のアニメーションとタイムアウトを破棄
            if (window.activeTurnSimId) {
                cancelAnimationFrame(window.activeTurnSimId);
                window.activeTurnSimId = null;
            }
            if (window.activeTurnSimTimeout) {
                clearTimeout(window.activeTurnSimTimeout);
                window.activeTurnSimTimeout = null;
            }

            const simCard = document.getElementById('tactical-sim-card');
            if (!hasExhibitionData) {
                if (simCard) simCard.classList.add('hidden');
                return;
            } else {
                if (simCard) simCard.classList.remove('hidden');
            }

            // 高DPI対応
            const dpr = window.devicePixelRatio || 1;
            let viewWidth = 0;
            let viewHeight = 0;

            let currentCombo = (solidFocus && solidFocus.length > 0) ? solidFocus[0] : "1-2-3";
            let fullOrder = [];
            let rankMap = {};
            let winnerLane = 1;
            let tacticLabel = "";
            let simRacers = [];
            let frame = 0;
            const maxFrames = 450;

            function getTacticLabel(wl) {
                if (wl === 1) return "1号艇 イン逃げ快勝パターン";
                if (wl === 2) return "2号艇 鋭い差し抜けパターン";
                if (wl === 3) return "3号艇 まくり/まくり差し炸裂";
                if (wl === 4) return "4号艇 カドからの一撃まくり";
                if (wl === 5) return "5号艇 展開を突くまくり差し";
                if (wl === 6) return "6号艇 大外から最内差し急浮上";
                return "展開予想パターン";
            }

            function setSimulationCombo(combo) {
                currentCombo = combo;
                const predictedNums = combo.replace(/[^1-6]/g, '').split('').map(Number);
                fullOrder = [...predictedNums];
                for (let b = 1; b <= 6; b++) {
                    if (!fullOrder.includes(b)) {
                        fullOrder.push(b);
                    }
                }
                rankMap = {};
                fullOrder.forEach((lane, idx) => {
                    rankMap[lane] = idx + 1;
                });
                winnerLane = fullOrder[0];
                tacticLabel = getTacticLabel(winnerLane);
            }

            setSimulationCombo(currentCombo);

            // Replayボタンのイベント設定
            const replayBtn = document.getElementById('replay-sim-btn');
            if (replayBtn) {
                const newReplayBtn = replayBtn.cloneNode(true);
                replayBtn.parentNode.replaceChild(newReplayBtn, replayBtn);
                newReplayBtn.addEventListener('click', () => {
                    startSim();
                });
            }

                        function initRacerPositions() {
                // 120パターン全展開・戦術辞書 (Tactical Role Engine)
                let stVals = {};
                racers.forEach(r => {
                    const l = parseInt(r.lane) || 1;
                    let v = 0.15;
                    if (r.st_val && r.st_val !== "N/A" && r.st_val !== "") {
                        v = parseFloat(r.st_val.replace('F', '')) || 0.15;
                        if (r.st_val.includes('F')) v = -v;
                    }
                    stVals[l] = v;
                });

                let roles = {};
                const w1 = fullOrder[0];
                const w2 = fullOrder[1];
                const w3 = fullOrder[2];

                for (let i = 1; i <= 6; i++) {
                    roles[i] = "OUT_FOLLOW";
                }

                if (w1 === 1) {
                    roles[1] = "NIGE";
                } else if (w1 === 2) {
                    roles[2] = (w2 === 1) ? "SASHI" : "MAKURI";
                } else if (w1 === 3) {
                    roles[3] = (w2 <= 2) ? "MAKURI_ZASHI" : "MAKURI";
                } else if (w1 === 4) {
                    roles[4] = (w2 <= 3) ? "MAKURI_ZASHI" : "MAKURI";
                } else if (w1 === 5) {
                    roles[5] = (w2 <= 4) ? "MAKURI_ZASHI" : "MAKURI";
                } else if (w1 === 6) {
                    roles[6] = "SASHI"; 
                }

                let makuriBoat = -1;
                if (roles[w1] === "MAKURI") makuriBoat = w1;

                if (w2 === 1) {
                    roles[1] = "IN_FOLLOW"; 
                } else if (w2 === 2) {
                    roles[2] = (w1 === 1) ? "SASHI_FOLLOW" : "OUT_FOLLOW";
                } else {
                    if (makuriBoat !== -1 && w2 > makuriBoat) {
                        roles[w2] = "MAKURI_FOLLOW"; 
                    } else {
                        roles[w2] = "OUT_FOLLOW";
                    }
                }

                roles[w3] = "THIRD_FOLLOW";

                for (let i = 1; i <= 6; i++) {
                    if (stVals[i] > 0.22 && i !== w1 && i !== w2 && i !== w3) {
                        roles[i] = "DELAYED";
                    }
                }

                if (makuriBoat !== -1) {
                    for (let i = 1; i < makuriBoat; i++) {
                        if (i !== w1 && i !== w2 && i !== w3) {
                            roles[i] = "BLOCKED_IN"; 
                        }
                    }
                }

                simRacers = racers.map(r => {
                    const laneNum = parseInt(r.lane) || 1;
                    const rank = rankMap[laneNum] || 6;
                    const stVal = stVals[laneNum];
                    const course = parseInt(r.st_course) || laneNum;
                    const exTime = parseFloat(r.ex_time) || 6.80;
                    const rate = parseFloat(r.rate) || 5.00;

                    let straightSpeed = (2.3 + (rate * 0.02) - (exTime - 6.70) * 0.8) * 0.6;
                    const baseRadius = 16 + (course - 1) * 9.5; 
                    
                    const role = roles[laneNum];
                    if (role === "MAKURI") straightSpeed += 0.35 * 0.6;
                    else if (role === "NIGE") straightSpeed += 0.08 * 0.6;

                    const turnSpeed = straightSpeed * (0.80 - (rank - 1) * 0.05);
                    const exitSpeed = (1.6 + (6 - rank) * 0.4) * 0.6;
                    
                    let stOffset = (0.15 - stVal) * 180; 
                    if (role === "DELAYED" || (course === 1 && stVal > 0.22)) {
                        stOffset -= 40; // 視覚的なドカ遅れ
                    }

                    return {
                        lane: laneNum,
                        name: r.name,
                        course: course,
                        rank: rank,
                        st: stVal,
                        role: role,
                        exTime: exTime,
                        rate: rate,
                        baseRadius: baseRadius,
                        radius: baseRadius,
                        straightSpeed: straightSpeed,
                        turnSpeed: turnSpeed,
                        exitSpeed: exitSpeed,
                        x: 40 + stOffset - (course * 5),
                        y: 96 + baseRadius,
                        angle: 0,
                        phi: Math.PI * 0.5,
                        phase: 1,
                        speed: straightSpeed
                    };
                });
            }

            function updatePhysics() {
                const markX = viewWidth - 110;
                const markY = 96;

                simRacers.forEach(sr => {
                    if (sr.phase === 1) {
                        const targetSpeed = sr.straightSpeed;
                        sr.speed += (targetSpeed - sr.speed) * 0.08;
                        sr.x += sr.speed;
                        sr.angle = 0;

                        if (sr.x >= markX) {
                            sr.phase = 2;
                            sr.phi = Math.PI * 0.5;
                        }
                    } 
                    else if (sr.phase === 2) {
                        const turnProgress = (Math.PI * 0.5 - sr.phi) / Math.PI; 
                        
                        let targetRadius = sr.baseRadius;
                        const role = sr.role;
                        
                        if (role === "NIGE") {
                            targetRadius = 15; 
                        } else if (role === "SASHI") {
                            targetRadius = (turnProgress > 0.4) ? 14 : sr.baseRadius + 4;
                        } else if (role === "MAKURI") {
                            targetRadius = (turnProgress > 0.2) ? 17 : Math.max(16, sr.baseRadius - 3);
                        } else if (role === "MAKURI_ZASHI") {
                            targetRadius = (turnProgress > 0.5) ? 15 : sr.baseRadius + 2;
                        } else if (role === "IN_FOLLOW") {
                            targetRadius = 20; 
                        } else if (role === "SASHI_FOLLOW") {
                            targetRadius = 24;
                        } else if (role === "MAKURI_FOLLOW") {
                            targetRadius = 28;
                        } else if (role === "THIRD_FOLLOW") {
                            targetRadius = 33;
                        } else if (role === "BLOCKED_IN") {
                            targetRadius = (turnProgress > 0.2) ? 55 : sr.baseRadius + 5;
                        } else if (role === "DELAYED") {
                            targetRadius = 50; 
                        } else {
                            targetRadius = 42 + (sr.rank - 4) * 6;
                        }

                        if (turnProgress > 0.1 && turnProgress < 0.9) {
                            sr.radius += (targetRadius - sr.radius) * 0.12;
                        }

                        const baseSpeedFactor = 1.0 - 0.35 * Math.sin(turnProgress * Math.PI);
                        let targetSpeed = sr.turnSpeed * baseSpeedFactor;
                        
                        if (turnProgress > 0.4) {
                            if (sr.rank === 1) targetSpeed *= 1.35;
                            else if (sr.rank === 2) targetSpeed *= 1.18;
                            else if (sr.rank === 3) targetSpeed *= 1.08;
                            else targetSpeed *= 0.85; 
                            
                            if (role === "BLOCKED_IN") targetSpeed *= 0.55; 
                            if (role === "DELAYED") targetSpeed *= 0.65;
                        }
                        
                        sr.speed += (targetSpeed - sr.speed) * 0.15;

                        const dPhi = sr.speed / sr.radius;
                        sr.phi -= dPhi;

                        sr.x = markX + sr.radius * Math.cos(sr.phi);
                        sr.y = markY + sr.radius * Math.sin(sr.phi);
                        sr.angle = sr.phi - Math.PI * 0.5;

                        if (sr.phi <= -Math.PI * 0.5) {
                            sr.phase = 3;
                            sr.y = markY - sr.radius;
                        }
                    } 
                    else if (sr.phase === 3) {
                        const targetSpeed = sr.exitSpeed;
                        sr.speed += (targetSpeed - sr.speed) * 0.08;
                        sr.x -= sr.speed;
                        sr.angle = Math.PI;
                    }
                });
            }

function draw() {
                ctx.fillStyle = '#090d16';
                ctx.fillRect(0, 0, viewWidth, viewHeight);
                
                const markX = viewWidth - 110;
                const markY = 96;

                ctx.strokeStyle = 'rgba(255, 255, 255, 0.1)';
                ctx.setLineDash([3, 3]);
                ctx.beginPath();
                ctx.arc(markX, markY, 20, 0, Math.PI * 2);
                ctx.stroke();
                ctx.setLineDash([]);

                ctx.fillStyle = '#ef4444'; 
                ctx.beginPath();
                ctx.arc(markX, markY, 7, 0, Math.PI * 2);
                ctx.fill();
                ctx.fillStyle = '#ffffff'; 
                ctx.beginPath();
                ctx.arc(markX, markY, 4, 0, Math.PI * 2);
                ctx.fill();
                ctx.fillStyle = '#ef4444'; 
                ctx.beginPath();
                ctx.arc(markX, markY, 2, 0, Math.PI * 2);
                ctx.fill();

                ctx.strokeStyle = 'rgba(255, 255, 255, 0.08)';
                ctx.beginPath();
                ctx.moveTo(110, 80);
                ctx.lineTo(110, viewHeight);
                ctx.stroke();

                ctx.fillStyle = 'rgba(255, 255, 255, 0.4)';
                ctx.font = 'bold 8px Inter';
                ctx.textAlign = 'center';
                ctx.fillText('1マーク', markX, markY - 14);

                simRacers.forEach(sr => {
                    if (sr.x < -30 || sr.x > viewWidth + 30) return;

                    ctx.save();
                    ctx.translate(sr.x, sr.y);
                    ctx.rotate(sr.angle);

                    ctx.beginPath();
                    ctx.moveTo(10, 0); 
                    ctx.lineTo(-6, -5.5); 
                    ctx.lineTo(-3, 0); 
                    ctx.lineTo(-6, 5.5); 
                    ctx.closePath();

                    let fillColor = '#ffffff';
                    let textColor = '#1e293b';
                    let strokeColor = 'transparent';
                    const drawLaneNum = parseInt(sr.lane) || 1;

                    if (drawLaneNum === 1) { fillColor = '#ffffff'; textColor = '#1e293b'; strokeColor = '#cbd5e1'; }
                    else if (drawLaneNum === 2) { fillColor = '#1e293b'; textColor = '#ffffff'; strokeColor = '#475569'; }
                    else if (drawLaneNum === 3) { fillColor = '#ef4444'; textColor = '#ffffff'; }
                    else if (drawLaneNum === 4) { fillColor = '#3b82f6'; textColor = '#ffffff'; }
                    else if (drawLaneNum === 5) { fillColor = '#eab308'; textColor = '#1e293b'; }
                    else if (drawLaneNum === 6) { fillColor = '#10b981'; textColor = '#ffffff'; }

                    ctx.fillStyle = fillColor;
                    ctx.fill();
                    if (strokeColor !== 'transparent') {
                        ctx.strokeStyle = strokeColor;
                        ctx.lineWidth = 1;
                        ctx.stroke();
                    }

                    ctx.rotate(-sr.angle); 
                    ctx.fillStyle = textColor;
                    ctx.font = '900 8px Outfit';
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    ctx.fillText(drawLaneNum, -1, 0.5);

                    ctx.restore();

                    const laneNum = parseInt(sr.lane) || 1;
                    if (frame > 95 && frame < 155 && laneNum === winnerLane) {
                        let badgeText = "逃げ";
                        let badgeBg = "rgba(16, 185, 129, 0.85)";
                        if (winnerLane === 2) {
                            badgeText = "差し";
                            badgeBg = "rgba(239, 68, 68, 0.85)";
                        } else if (winnerLane === 3) {
                            badgeText = "まくり";
                            badgeBg = "rgba(245, 158, 11, 0.85)";
                        } else if (winnerLane === 4) {
                            badgeText = "まくり";
                            badgeBg = "rgba(59, 130, 246, 0.85)";
                        } else if (winnerLane === 5) {
                            badgeText = "まくり差し";
                            badgeBg = "rgba(234, 179, 8, 0.85)";
                        } else if (winnerLane === 6) {
                            badgeText = "差し";
                            badgeBg = "rgba(139, 92, 246, 0.85)";
                        }

                        ctx.save();
                        ctx.fillStyle = badgeBg;
                        const badgeW = badgeText.length * 6 + 10;
                        ctx.beginPath();
                        if (typeof ctx.roundRect === 'function') {
                            ctx.roundRect(sr.x - badgeW/2, sr.y - 18, badgeW, 10, 3);
                        } else {
                            ctx.rect(sr.x - badgeW/2, sr.y - 18, badgeW, 10);
                        }
                        ctx.fill();

                        ctx.fillStyle = "#ffffff";
                        ctx.font = 'bold 7px sans-serif';
                        ctx.textAlign = 'center';
                        ctx.textBaseline = 'middle';
                        ctx.fillText(badgeText, sr.x, sr.y - 13);
                        ctx.restore();
                    }

                });

                let hudStatus = "";
                let hudColor = "rgba(255, 255, 255, 0.4)";
                if (frame < 140) {
                    hudStatus = "ホームストレッチ - スリット通過";
                } else if (frame >= 140 && frame < 280) {
                    hudStatus = "第1ターンマーク - 旋回攻防";
                    hudColor = "#f43f5e";
                } else {
                    hudStatus = "バックストレッチ - AI判定着順";
                    hudColor = "#10b981";
                }

                ctx.fillStyle = 'rgba(15, 23, 42, 0.4)';
                ctx.fillRect(8, 6, 120, 16);
                ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
                ctx.strokeRect(8, 6, 120, 16);
                ctx.fillStyle = hudColor;
                ctx.font = 'bold 8px sans-serif';
                ctx.textAlign = 'left';
                ctx.fillText("📡 " + hudStatus, 14, 14);

                if (frame > 160 && frame < 400) {
                    let descText = "";
                    if (frame < 260) {
                        if (winnerLane === 1) descText = "1号艇がインから先マイ逃げ体制！";
                        else if (winnerLane === 2) descText = "2号艇が内を狙って鋭く切り込む！";
                        else if (winnerLane === 3) descText = "3号艇が全速で外から握ってまわる！";
                        else if (winnerLane === 4) descText = "4号艇がカドから一気にしぼってまくる！";
                        else if (winnerLane === 5) descText = "5号艇が連動してまくり差しを狙う！";
                        else if (winnerLane === 6) descText = "6号艇が大外から最内へ差しに入る！";
                    } else {
                        descText = tacticLabel;
                    }

                    ctx.fillStyle = 'rgba(15, 23, 42, 0.8)';
                    ctx.fillRect(viewWidth / 2 - 95, 8, 190, 20);
                    ctx.strokeStyle = 'rgba(99, 102, 241, 0.2)';
                    ctx.strokeRect(viewWidth / 2 - 95, 8, 190, 20);

                    ctx.fillStyle = '#f1f5f9';
                    ctx.font = 'bold 9px sans-serif';
                    ctx.textAlign = 'center';
                    ctx.fillText(descText, viewWidth / 2, 21);
                }

                ctx.fillStyle = 'rgba(255, 255, 255, 0.05)';
                ctx.fillRect(0, viewHeight - 2, viewWidth, 2);
                ctx.fillStyle = 'rgba(99, 102, 241, 0.6)';
                ctx.fillRect(0, viewHeight - 2, viewWidth * (frame / maxFrames), 2);
            }

            function buildControls() {
                const solidContainer = document.getElementById('sim-controls-solid');
                const upsetContainer = document.getElementById('sim-controls-upset');
                if (solidContainer) solidContainer.innerHTML = '';
                if (upsetContainer) upsetContainer.innerHTML = '';

                function createSimBtn(combo, isUpt, index) {
                    const btn = document.createElement('button');
                    let label = '抑え';
                    if (!isUpt) {
                        if (index === 0) label = '大本線';
                        else if (index === 1) label = '本線';
                    } else {
                        if (index === 0) label = '中穴';
                        else if (index === 1) label = '穴狙い';
                    }
                    
                    const baseClass = isUpt 
                        ? 'px-2 py-1 text-[9px] rounded-lg border border-purple-500/20 bg-purple-500/5 text-purple-400 font-bold hover:bg-purple-500/10 active:scale-95 transition-all cursor-pointer'
                        : 'px-2 py-1 text-[9px] rounded-lg border border-indigo-500/20 bg-indigo-500/5 text-indigo-400 font-bold hover:bg-indigo-500/10 active:scale-95 transition-all cursor-pointer';
                    
                    const activeClass = isUpt
                        ? 'px-2 py-1 text-[9px] rounded-lg border border-purple-500 bg-purple-500/20 text-purple-300 font-black scale-[1.03] shadow-sm shadow-purple-500/10 cursor-pointer'
                        : 'px-2 py-1 text-[9px] rounded-lg border border-indigo-500 bg-indigo-500/20 text-indigo-300 font-black scale-[1.03] shadow-sm shadow-indigo-500/10 cursor-pointer';
                    
                    btn.className = (combo === currentCombo) ? activeClass : baseClass;
                    btn.innerText = `${label} (${combo})`;
                    
                    btn.addEventListener('click', () => {
                        const allBtns = document.querySelectorAll('#sim-controls-container button');
                        allBtns.forEach(b => {
                            const isBUt = b.parentElement.id === 'sim-controls-upset';
                            b.className = isBUt
                                ? 'px-2 py-1 text-[9px] rounded-lg border border-purple-500/20 bg-purple-500/5 text-purple-400 font-bold hover:bg-purple-500/10 active:scale-95 transition-all cursor-pointer'
                                : 'px-2 py-1 text-[9px] rounded-lg border border-indigo-500/20 bg-indigo-500/5 text-indigo-400 font-bold hover:bg-indigo-500/10 active:scale-95 transition-all cursor-pointer';
                        });
                        btn.className = activeClass;

                        setSimulationCombo(combo);
                        startSim();
                    });

                    return btn;
                }

                if (solidContainer && solidFocus) {
                    if (solidFocus.length === 1 && solidFocus[0] === "見") {
                        const skipSpan = document.createElement('span');
                        skipSpan.className = 'px-2 py-1 text-[9px] rounded-lg border border-slate-700 bg-slate-900/40 text-slate-400 font-medium cursor-not-allowed select-none';
                        skipSpan.innerText = `🛑 見（ケン推奨）`;
                        solidContainer.appendChild(skipSpan);
                    } else {
                        solidFocus.forEach((combo, idx) => {
                            solidContainer.appendChild(createSimBtn(combo, false, idx));
                        });
                    }
                }
                if (upsetContainer && upsetFocus) {
                    if (upsetFocus.length === 1 && upsetFocus[0] === "見") {
                        const skipSpan = document.createElement('span');
                        skipSpan.className = 'px-2 py-1 text-[9px] rounded-lg border border-slate-700 bg-slate-900/40 text-slate-400 font-medium cursor-not-allowed select-none';
                        skipSpan.innerText = `🛑 見（ケン推奨）`;
                        upsetContainer.appendChild(skipSpan);
                    } else {
                        upsetFocus.forEach((combo, idx) => {
                            const isGasApp = window.location.hostname.indexOf('script.google') !== -1 || 
                                             window.location.hostname.indexOf('googleusercontent') !== -1;
                            if (idx >= 2 && !isGasApp) {
                                const lockSpan = document.createElement('span');
                                lockSpan.className = 'px-2 py-1 text-[9px] rounded-lg border border-slate-800 bg-slate-950/40 text-slate-500 font-medium cursor-not-allowed select-none';
                                lockSpan.innerText = `🔒 穴予想ロック中 (${combo})`;
                                upsetContainer.appendChild(lockSpan);
                            } else {
                                upsetContainer.appendChild(createSimBtn(combo, true, idx));
                            }
                        });
                    }
                }
            }

            function animate() {
                updatePhysics();
                draw();

                frame++;
                if (frame < maxFrames) {
                    window.activeTurnSimId = requestAnimationFrame(animate);
                } else {
                    window.activeTurnSimTimeout = setTimeout(() => {
                        if (document.getElementById('turn-sim-canvas') === canvas) {
                            startSim();
                        }
                    }, 2500);
                }
            }

            function startSim() {
                if (window.activeTurnSimId) {
                    cancelAnimationFrame(window.activeTurnSimId);
                    window.activeTurnSimId = null;
                }
                if (window.activeTurnSimTimeout) {
                    clearTimeout(window.activeTurnSimTimeout);
                    window.activeTurnSimTimeout = null;
                }

                // Canvasのサイズをリアルタイム計測してリサイズ
                const rect = canvas.getBoundingClientRect();
                canvas.width = rect.width * dpr;
                canvas.height = rect.height * dpr;
                ctx.setTransform(1, 0, 0, 1, 0, 0); // スケールをリセット
                ctx.scale(dpr, dpr);
                viewWidth = rect.width;
                viewHeight = rect.height;

                frame = 0;
                initRacerPositions();
                animate();
            }

            buildControls();
            startSim();
        }


        // 広告ロック解除用ロジック
        window.unlockWithAd = function() {
            const modal = document.getElementById('ad-unlock-modal');
            if (modal) {
                modal.classList.remove('hidden');
                setTimeout(() => modal.classList.remove('opacity-0'), 10);
                
                // Simulate Ad viewing time (2.5 seconds for demo)
                setTimeout(() => {
                    modal.classList.add('opacity-0');
                    setTimeout(() => {
                        modal.classList.add('hidden');
                        
                        const firstAdOverlay = document.getElementById('first-ai-ad-overlay');
                        const firstUpsetContainer = document.getElementById('first-ai-upset-focus');
                        if (firstAdOverlay) firstAdOverlay.classList.add('hidden');
                        if (firstUpsetContainer) firstUpsetContainer.classList.remove('premium-blur');
                        
                        const adKey = window.getAdUnlockKey();
                        if (adKey) {
                            sessionStorage.setItem(adKey, 'true');
                        }
                    }, 300);
                }, 2500);
            }
        };

        window.triggerAdUnlock = function(targetWrapper, lockEl, onSuccess) {
            window.showLoginModal();
        };

        // 規約モーダル表示制御
        window.showTermsModal = function(type) {
            const modal = document.getElementById('terms-modal');
            const disclaimerContent = document.getElementById('terms-content-disclaimer');
            const privacyContent = document.getElementById('terms-content-privacy');
            const aboutContent = document.getElementById('terms-content-about');
            const helpContent = document.getElementById('terms-content-help');
            const tokushohoContent = document.getElementById('terms-content-tokushoho');
            const title = document.getElementById('terms-title');
            
            if (!modal || !disclaimerContent || !privacyContent || !aboutContent || !helpContent || !tokushohoContent || !title) return;

            // すべて隠す
            disclaimerContent.classList.add('hidden');
            privacyContent.classList.add('hidden');
            aboutContent.classList.add('hidden');
            helpContent.classList.add('hidden');
            tokushohoContent.classList.add('hidden');

            if (type === 'disclaimer') {
                title.innerText = "⚖️ 免責事項";
                disclaimerContent.classList.remove('hidden');
            } else if (type === 'privacy') {
                title.innerText = "🛡️ プライバシーポリシー";
                privacyContent.classList.remove('hidden');
            } else if (type === 'about') {
                title.innerText = "🏁 このサイトについて";
                aboutContent.classList.remove('hidden');
            } else if (type === 'help') {
                title.innerText = "💡 予想の見方・使い方";
                helpContent.classList.remove('hidden');
            } else if (type === 'tokushoho') {
                title.innerText = "⚖️ 特定商取引法に基づく表記";
                tokushohoContent.classList.remove('hidden');
            }

            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modal.classList.add('opacity-100');
            }, 10);
        };

        window.closeTermsModal = function() {
            const modal = document.getElementById('terms-modal');
            if (!modal) return;

            modal.classList.remove('opacity-100');
            modal.classList.add('opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        };

