            <div class="mt-4 pt-3 border-t border-white/5">
                <button onclick="window.closeTermsModal()" class="w-full py-2 bg-slate-800 hover:bg-slate-700 text-white text-xs font-bold rounded-xl border border-white/5 transition-all">
                    閉じる
                </button>
