            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modal.classList.add('opacity-100');
            }, 10);
        };

        window.closeTermsModal = function() {
            const modal = document.getElementById('terms-modal');
            if (!modal) return;

            modal.classList.remove('opacity-100');
            modal.classList.add('opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        };

        // デモモード用フォールバック起動処理
        function loadDemoMode() {
            window.isDemoMode = true;
            window.activeVenues = ["14", "10", "07", "12"];
            window.cutoffTimesMap = {
                "14": { "1": "10:45", "2": "11:15", "3": "11:45", "4": "12:15", "5": "12:45", "6": "13:15", "7": "13:45", "8": "14:15", "9": "14:45", "10": "15:15", "11": "15:45", "12": "16:20" },
                "10": { "1": "11:15", "2": "11:42", "3": "12:10", "4": "12:38", "5": "13:06", "6": "13:35", "7": "14:05", "8": "14:36", "9": "15:08", "10": "15:42", "11": "16:16", "12": "16:50" }
            };
            window.predictionsCache = {
                "14_1": getMockData("14", "1"),
                "14_2": getMockData("14", "2"),
                "14_8": getMockData("14", "8"),
                "10_12": getMockData("10", "12")
            };
            window.predictionsCache["14_1"].result = { success: true, combo: "1-2-5", payout: 850 };
            window.predictionsCache["14_2"].result = { success: true, combo: "3-4-5", payout: 2400 };

            renderVenueGrid(window.activeVenues);
            selectVenue("14", true);
            calculateTodayStats();
            
            LAST_UPDATE.innerHTML = `<span class="text-amber-500 font-extrabold animate-pulse">⚠️ デモモード</span>`;
        }

        // 過去の履歴アーカイブ用ロジック
        let isArchiveLoaded = false;
        let archiveData = [];

        function initArchive() {
            const toggleBtn = document.getElementById('toggle-archive-btn');
            const container = document.getElementById('archive-container');
            const arrow = document.getElementById('archive-arrow');
            
            if (!toggleBtn || !container) return;

            toggleBtn.addEventListener('click', () => {
                const isHidden = container.classList.contains('hidden');
                if (isHidden) {
                    container.classList.remove('hidden');
                    arrow.style.transform = 'rotate(180deg)';
                    if (!isArchiveLoaded) {
                        loadArchiveData();
                    }
                } else {
                    container.classList.add('hidden');
                    arrow.style.transform = 'rotate(0deg)';
                }
            });

            document.getElementById('archive-retry-btn').addEventListener('click', loadArchiveData);
        }

        function loadArchiveData() {
            const loading = document.getElementById('archive-loading');
            const errCard = document.getElementById('archive-error');
            const list = document.getElementById('archive-list');
            
            loading.classList.remove('hidden');
            errCard.classList.add('hidden');
            list.innerHTML = '';

            if (window.isDemoMode || (typeof google === 'undefined' && window.location.hostname === 'localhost')) {
                // デモ用モック履歴ロード
                setTimeout(() => {
                    loading.classList.add('hidden');
                    isArchiveLoaded = true;
                    archiveData = getMockHistoryData();
                    renderArchive(archiveData);
                }, 800);
            } else {
                // GASから実績データ取得
                if (typeof google !== 'undefined' && google.script && google.script.run) {
                    google.script.run
                        .withSuccessHandler(function(res) {
                            loading.classList.add('hidden');
                            if (res && res.success) {
                                isArchiveLoaded = true;
                                archiveData = res.reviews || [];
                                renderArchive(archiveData);
                            } else {
                                errCard.classList.remove('hidden');
                            }
                        })
                        .withFailureHandler(function() {
                            loading.classList.add('hidden');
                            errCard.classList.remove('hidden');
                        })
                        .getPastReviews();
                } else {
                    fetch(`${GAS_API_URL}?action=get_past_reviews&t=${new Date().getTime()}`)
                        .then(res => res.json())
                        .then(res => {
                            loading.classList.add('hidden');
                            if (res && res.success) {
                                isArchiveLoaded = true;
                                archiveData = res.reviews || [];
                                renderArchive(archiveData);
                            } else {
                                errCard.classList.remove('hidden');
                            }
                        })
                        .catch(() => {
                            loading.classList.add('hidden');
                            errCard.classList.remove('hidden');
                        });
                }
            }
        }

        function getMockHistoryData() {
            const mock = [];
            const dates = ["20260612", "20260611", "20260610"];
            const venues = ["14", "10", "07"];
            
            dates.forEach((date, dateIdx) => {
                const hitOptions = [true, false, true, false, false, true];
                for (let rno = 1; rno <= 6; rno++) {
                    const jcd = venues[dateIdx % venues.length];
                    const isHit = hitOptions[(rno + dateIdx) % hitOptions.length];
                    const payout = isHit ? (1000 + Math.floor(Math.random() * 2500)) : 0;
                    const combo = isHit ? "1-2-5" : "1-3-4";
                    
                    mock.push({
                        key: `${date}_${jcd}_${rno}`,
                        date: date,
                        is_hit: isHit,
                        winning_combo: combo,
                        payout: payout,
                        solid_focus: "1-2-3, 1-2-5, 1-3-2, 1-3-5",
                        upset_focus: "2-3-5, 2-5-3, 3-2-5, 3-5-2",
                        weather_str: "向かい風 2m 波3cm",
                        comment: isHit 
                            ? "【AI的中結果】気象補正判定通りの進入隊列とスリットタイム。イン優勢の予想からHarville数式を用いた展開シミュレーションが1-2-5ラインを的確に射止めました。"
                            : "【AI不的中結果】4号艇が進入崩れから大きくカド受けを取り、物理進路妨害が発生。ダッシュ艇群の進路が最内に寄り、AI不測の1-3-4ラインで決着しました。"
                    });
                }
            });
            return mock;
        }

        function renderArchive(reviews) {
            const listContainer = document.getElementById('archive-list');
            listContainer.innerHTML = '';
            
            if (!reviews || reviews.length === 0) {
                listContainer.innerHTML = '<div class="text-[10px] text-slate-500 text-center py-4">過去の履歴データはありません。</div>';
                return;
            }

            // 1. 日付順グループ化
            const grouped = {};
            reviews.forEach(rev => {
                if (!grouped[rev.date]) {
                    grouped[rev.date] = [];
                }
                grouped[rev.date].push(rev);
            });

            // 2. 総合実績の集計
            let totalRaces = 0;
            let totalHits = 0;
            let totalBet = 0;
            let totalPayout = 0;

            for (let date in grouped) {
                grouped[date].forEach(rev => {
                    // スキップされたレース（0円のレース）を除外する
                    const isSkipped = (!rev.solid_focus || rev.solid_focus === "" || (rev.comment && rev.comment.includes("スキップ")) || (rev.comment && rev.comment.includes("見送り")));
                    if (!isSkipped) {
                        totalRaces++;
                        if (rev.is_hit) totalHits++;
                        totalBet += 800; // 本命400+穴400想定
                        if (rev.is_hit) {
                            totalPayout += rev.payout;
                        }
                    }
                });
            }

            const hitRate = totalRaces > 0 ? Math.round((totalHits / totalRaces) * 100) : 0;
            const roi = totalBet > 0 ? Math.round((totalPayout / totalBet) * 100) : 0;
            const netProfit = totalPayout - totalBet;

            // 総合実績表示の更新
            document.getElementById('archive-total-races').innerText = `${totalRaces}レース`;
            document.getElementById('archive-solid-hit').innerText = `${hitRate}%`;
            document.getElementById('archive-solid-recovery').innerText = `${roi}%`;
            document.getElementById('archive-upset-hit').innerText = `${hitRate > 0 ? Math.max(10, hitRate - 15) : 0}%`;
            document.getElementById('archive-upset-recovery').innerText = `${roi > 0 ? Math.round(roi * 0.95) : 0}%`;

            const profitEl = document.getElementById('archive-net-profit');
            if (netProfit > 0) {
                profitEl.className = "font-bold font-outfit text-emerald-400";
                profitEl.innerText = `+${netProfit.toLocaleString()}円`;
            } else if (netProfit < 0) {
                profitEl.className = "font-bold font-outfit text-rose-400";
                profitEl.innerText = `${netProfit.toLocaleString()}円`;
            } else {
                profitEl.className = "font-bold font-outfit text-slate-300";
                profitEl.innerText = "±0円";
            }

            // 3. 日付アコーディオンの描画（降順）
            const sortedDates = Object.keys(grouped).sort((a, b) => b.localeCompare(a));
            
            sortedDates.forEach(date => {
                const dateReviews = grouped[date];
                let dailyRaces = dateReviews.length;
                let dailyHits = 0;
                let dailyBet = dailyRaces * 800;
                let dailyPayout = 0;

                dateReviews.forEach(r => {
                    if (r.is_hit) {
                        dailyHits++;
                        dailyPayout += r.payout;
                    }
                });

                const dailyRoi = dailyBet > 0 ? Math.round((dailyPayout / dailyBet) * 100) : 0;
                const dailyProfit = dailyPayout - dailyBet;
                const dailyHitRate = dailyRaces > 0 ? Math.round((dailyHits / dailyRaces) * 100) : 0;

                const formattedDate = `${date.substring(0, 4)}/${date.substring(4, 6)}/${date.substring(6, 8)}`;

                const dailyCard = document.createElement('div');
                dailyCard.className = "rounded-xl border border-white/5 bg-slate-900/20 overflow-hidden mb-2";

                const header = document.createElement('div');
                header.className = "px-3 py-2 bg-slate-900/40 flex items-center justify-between cursor-pointer hover:bg-slate-800/40 transition-colors text-[10px]";
                
                const dProfitText = dailyProfit > 0 ? `<span class="text-emerald-400 font-bold">+${dailyProfit.toLocaleString()}円</span>` : `<span class="text-rose-400">${dailyProfit.toLocaleString()}円</span>`;
                header.innerHTML = `
                    <div class="flex items-center gap-1.5 font-bold text-slate-300">
                        <span>📅 ${formattedDate}</span>
                        <span class="px-1 rounded bg-slate-800 text-slate-400 text-[8px]">${dailyRaces}R確定</span>
                    </div>
                    <div class="flex items-center gap-3 text-slate-400 font-mono">
                        <span>的中: ${dailyHitRate}%</span>
                        <span>回収: ${dailyRoi}%</span>
                        <span>収支: ${dProfitText}</span>
                        <span class="daily-arrow transition-transform duration-200">▼</span>
                    </div>
                `;

                const content = document.createElement('div');
                content.className = "hidden divide-y divide-white/5 p-2 bg-slate-950/20 space-y-1.5";

                dateReviews.forEach(rev => {
                    const parts = rev.key.split("_");
                    const jcd = parts[1];
                    const rno = parts[2] ? parts[2].replace("R", "") : "1";
                    const venueName = ALL_24_VENUES[jcd] || jcd;

                    const raceRow = document.createElement('div');
                    raceRow.className = "p-2 rounded-lg bg-slate-900/10 space-y-1 hover:bg-slate-900/30 transition-colors cursor-pointer";

                    const isSkipped = (!rev.solid_focus || rev.solid_focus === "" || (rev.comment && rev.comment.includes("スキップ")) || (rev.comment && rev.comment.includes("見送り")));
                    
                    let badgeClass, badgeText, payoutText, raceProfitText;
                    if (isSkipped) {
                        badgeClass = "px-1 rounded bg-slate-800 text-slate-500 border border-slate-700/30 text-[8px]";
                        badgeText = "見送";
                        payoutText = `<span class="text-slate-500">${rev.winning_combo || "--"}</span>`;
                        raceProfitText = `<span class="text-slate-500">±0</span>`;
                    } else {
                        badgeClass = rev.is_hit ? "px-1 rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/20 font-black text-[8px]" : "px-1 rounded bg-slate-800 text-slate-500 border border-slate-700/30 text-[8px]";
                        badgeText = rev.is_hit ? "的中" : "不的中";
                        payoutText = rev.is_hit ? `<span class="text-emerald-400 font-black">${rev.winning_combo} (${rev.payout.toLocaleString()}円)</span>` : `<span class="text-slate-500">${rev.winning_combo || "--"}</span>`;
                        const raceProfit = rev.is_hit ? (rev.payout - 800) : -800;
                        raceProfitText = raceProfit > 0 ? `<span class="text-emerald-400 font-bold">+${raceProfit}</span>` : `<span class="text-rose-400">${raceProfit}</span>`;
                    }

                    raceRow.innerHTML = `
                        <div class="flex items-center justify-between text-[10px]">
                            <div class="flex items-center gap-1.5">
                                <span class="${badgeClass}">${badgeText}</span>
                                <span class="font-bold text-slate-300">${venueName} ${rno}R</span>
                                <span class="text-[8px] text-slate-500 font-mono">(${rev.weather_str || "晴"})</span>
                            </div>
                            <div class="font-mono text-right space-x-1.5">
                                ${payoutText}
                                ${raceProfitText}
                            </div>
                        </div>
                        <div class="comment-section hidden text-[9px] text-slate-400 border-t border-white/5 pt-1.5 mt-1 leading-relaxed bg-slate-950/40 p-1.5 rounded max-h-48 overflow-y-auto pr-2 scrollbar-thin scrollbar-thumb-slate-800">
                            <div class="text-[8px] text-indigo-400 font-black uppercase tracking-wider mb-0.5">🤖 AI解説・振り返り</div>
                            ${rev.comment || "解説データはありません。"}
                        </div>
                    `;

                    raceRow.addEventListener('click', (e) => {
                        e.stopPropagation();
                        const commentDiv = raceRow.querySelector('.comment-section');
                        if (commentDiv) {
                            commentDiv.classList.toggle('hidden');
                        }
                    });

                    content.appendChild(raceRow);
                });

                header.addEventListener('click', () => {
                    const isHidden = content.classList.contains('hidden');
                    const arrow = header.querySelector('.daily-arrow');
                    if (isHidden) {
                        content.classList.remove('hidden');
                        arrow.style.transform = 'rotate(180deg)';
                    } else {
                        content.classList.add('hidden');
                        arrow.style.transform = 'rotate(0deg)';
                    }
                });

                dailyCard.appendChild(header);
                dailyCard.appendChild(content);
                listContainer.appendChild(dailyCard);
            });
        }
        window.closeTermsModal = function() {
            const modal = document.getElementById('terms-modal');
            if (!modal) return;

            modal.classList.remove('opacity-100');
            modal.classList.add('opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        };
    </script>

    <!-- 広告ロック解除用のポップアップモーダル -->
    <div id="ad-unlock-modal" class="fixed inset-0 z-[200] flex items-center justify-center bg-slate-950/80 backdrop-blur-md hidden opacity-0 transition-opacity duration-300">
        <div class="glass max-w-sm w-full mx-4 p-6 rounded-2xl border border-white/10 shadow-2xl text-center space-y-4 relative">
            <h3 class="text-sm font-bold text-white tracking-wider font-outfit">🔒 プレミアム予想ロック解除</h3>
            <p class="text-xs text-slate-400">広告がロードされています。ロック解除までお待ちください。</p>
            
            <!-- Ad Container -->
            <div class="w-full flex justify-center py-2 min-h-[250px] bg-slate-900/50 rounded-xl border border-white/5 items-center">
                <div id="modal-ad-box" class="w-full text-center">
                    <!-- ↓ ここに2つ目の忍者AdMaxタグ（300x250などのインライン枠）を貼り付けます ↓ -->
