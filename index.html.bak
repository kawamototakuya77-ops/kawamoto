    <!-- LOGIN MODAL -->
    <div id="login-modal" class="fixed inset-0 z-[250] flex items-center justify-center bg-slate-950/85 backdrop-blur-md hidden opacity-0 transition-opacity duration-300">
        <div class="glass max-w-sm w-full mx-4 p-6 rounded-2xl border border-white/10 shadow-2xl relative">
            <h3 class="text-sm font-bold text-white tracking-wider font-outfit mb-4 text-center">プレミアムログイン</h3>
            <div class="space-y-4">
                <div>
                    <label class="block text-[10px] font-bold text-slate-400 mb-1">メールアドレス</label>
                    <input type="email" id="login-email-input" placeholder="登録メールアドレスを入力" class="w-full bg-slate-900 border border-white/10 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-indigo-500 transition-colors">
                </div>
                <div>
                    <label class="block text-[10px] font-bold text-slate-400 mb-1">ライセンスキー (パスワード)</label>
                    <input type="text" id="login-pass-input" placeholder="キーを入力" class="w-full bg-slate-900 border border-white/10 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-indigo-500 transition-colors font-mono">
                </div>
                <button onclick="window.submitLogin()" class="w-full py-2.5 bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-400 hover:to-purple-500 text-white text-xs font-bold rounded-xl shadow-lg transition-all transform hover:scale-[1.02]">
                    🔓 ロックを解除する
                </button>
                <div class="pt-4 border-t border-white/5 text-center space-y-2">
                    <p class="text-[10px] text-slate-400">プレミアムパスをお持ちでない方はこちら</p>
                    <a href="https://buy.stripe.com/eVq6oH9Qi39w3BT8rtgjC01" target="_blank" class="block w-full py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold rounded-xl border border-white/5 transition-all">
                        👑 プレミアム登録 (月額500円)
                    </a>
                </div>
            </div>
            <button onclick="window.closeLoginModal()" class="absolute top-3 right-3 text-slate-400 hover:text-white">✕</button>
        </div>
    </div>

    <!-- ユーザー名設定モーダル (初回のみ) -->
    <div id="username-modal" class="fixed inset-0 z-[60] hidden flex items-center justify-center p-4 transition-opacity duration-300 opacity-0 backdrop-blur-sm bg-black/60">
        <div class="glass max-w-sm w-full mx-4 p-6 rounded-2xl border border-indigo-500/30 shadow-[0_0_30px_rgba(99,102,241,0.2)] relative">
            <h3 class="text-lg font-bold text-white tracking-wider font-outfit mb-2 text-center text-indigo-400">ようこそプレミアムへ！</h3>
            <p class="text-xs text-slate-300 mb-4 text-center leading-relaxed">
                BBS（プレミアム専用掲示板）で表示される<br>
                あなたのユーザー名を設定してください。<br>
                <span class="text-[10px] text-slate-400">※後からいつでも変更可能です</span>
            </p>
            <div class="space-y-4">
                <div>
                    <input type="text" id="setup-username-input" placeholder="2〜15文字（例：競艇太郎）" class="w-full bg-slate-900 border border-white/10 rounded-xl px-3 py-3 text-sm text-white focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all text-center font-bold tracking-wide">
                </div>
                <button onclick="window.submitUsername()" class="w-full py-3 bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-400 hover:to-purple-500 text-white text-sm font-bold rounded-xl shadow-lg transition-all transform hover:scale-[1.02]">
                    設定を完了する
                </button>
            </div>
        </div>
    </div>

    <script>
        function containsBadWords(str) {
            if (!str) return false;
            var normalized = str.toLowerCase().replace(/[\s　\-_]/g, "");
            normalized = normalized.replace(/[\u30a1-\u30f6]/g, function(match) {
                var chr = match.charCodeAt(0) - 0x60;
                return String.fromCharCode(chr);
            });
            var badPatterns = [
                /ちん[こぽ]/, /まんこ/, /おまんこ/, /ぺにす/, /ペニス/, /ばぎな/, /ヴァギナ/,
                /せっくす/, /セックス/, /ふぇら/, /フェラ/, /くんに/, /クンニ/, /アナル/, /あなる/,
                /おなにい/, /オナニー/, /なまだし/, /中出し/, /ばいぶ/, /バイブ/, /ろーたー/, /ローター/,
                /きちがい/, /キチガイ/, /基地外/, /どじん/, /土人/, /しなじん/, /支那/, /ちょん/, /チョン/,
                /がいじ/, /ガイジ/, /めくら/, /つんぼ/, /ちんば/, /ぶらく/, /部落/, /ひにん/, /非人/,
                /しね/, /死ね/, /ころす/, /殺す/, /ばか/, /馬鹿/, /ごみ/, /ゴミ/,
                /fuck/, /shit/, /bitch/, /cunt/, /nigger/, /fag/, /pussy/, /cock/
            ];
            for (var i = 0; i < badPatterns.length; i++) {
                if (badPatterns[i].test(normalized)) return true;
            }
            return false;
        }

        window.showLoginModal = function() {
            const modal = document.getElementById('login-modal');
            const passInput = document.getElementById('login-pass-input');
            const emailInput = document.getElementById('login-email-input');
            const usernameInput = document.getElementById('login-username-input');
            if(passInput) passInput.value = window.getPremiumPass();
            if(emailInput) emailInput.value = window.getPremiumEmail();
            if(usernameInput) usernameInput.value = localStorage.getItem('PREMIUM_USERNAME_KEY') || "";
            modal.classList.remove('hidden');
            setTimeout(() => modal.classList.remove('opacity-0'), 10);
            // GA4: ログインモーダル表示 = ファネルの第2ステップ
            window._ga4Event('login_modal_open', { method: 'button' });
        };
        window.closeLoginModal = function() {
            const modal = document.getElementById('login-modal');
            modal.classList.add('opacity-0');
            setTimeout(() => modal.classList.add('hidden'), 300);
        };
        
        window.showUsernameModal = function() {
            const modal = document.getElementById('username-modal');
            modal.classList.remove('hidden');
            setTimeout(() => modal.classList.remove('opacity-0'), 10);
        };
        window.closeUsernameModal = function() {
            const modal = document.getElementById('username-modal');
            modal.classList.add('opacity-0');
            setTimeout(() => modal.classList.add('hidden'), 300);
        };

        window.submitLogin = function() {
            const passInput = document.getElementById('login-pass-input');
            const emailInput = document.getElementById('login-email-input');
            
            if(!passInput || !emailInput) return;
            
            const email = emailInput.value.trim();
            const pass = passInput.value.trim();
            
            if(!email || !pass) {
                alert("メールアドレスとライセンスキーを入力してください。");
                return;
            }
            
            // --- UI TEST BYPASS ---
            if (pass === "test") {
                window.savePremiumAuth(email, pass);
                window.closeLoginModal();
                updateLoginIcon(true);
                // force unlock in UI
                const cardsToBlur = [
                    document.getElementById('live-ai-card'),
                    document.getElementById('live-ai-comment-container'),
                    document.getElementById('weather-card'),
                    document.querySelector('#premium-zone > section:nth-of-type(3)'),
                    document.getElementById('tactical-sim-card'),
                    document.querySelector('#premium-zone > section:last-of-type')
                ];
                cardsToBlur.forEach(card => { if(card) card.classList.remove('premium-blur'); });
                const premiumOverlay = document.getElementById('premium-overlay');
                if (premiumOverlay) premiumOverlay.classList.add('hidden');
                alert("【テストモード】モザイクを解除しました！");
                return;
            }

            window.savePremiumAuth(email, pass);
            
            const btn = document.querySelector("#login-modal button");
            const originalText = btn.textContent;
            btn.disabled = true;
            btn.textContent = "認証中...";
            
            const verifyUrl = `${GAS_API_URL}?action=verify_license&email=${encodeURIComponent(email)}&pass=${encodeURIComponent(pass)}&t=${new Date().getTime()}`;
            
            // GA4: 認証試行 = ファネルの第3ステップ
            window._ga4Event('verify_attempt', { method: 'license_key' });

            fetch(verifyUrl)
                .then(res => res.json())
                .then(res => {
                    btn.disabled = false;
                    btn.textContent = originalText;
                    if(res && res.success) {
                        // GA4: 認証成功 = コンバージョン完了イベント
                        window._ga4Event('verify_success', { method: 'license_key', value: 500 });
                        alert("認証成功！データを読み込みます...");
                        window.closeLoginModal();
                        updateLoginIcon();
                        fetchLatestDataSilently();
                    } else {
                        alert(`認証に失敗しました。\n理由: ${res ? res.error : "レスポンスエラー"}\nメールアドレスとライセンスキーを確認してください。`);
                        window.savePremiumAuth("", ""); // 失敗時はクリア
                    }
                })
                .catch(err => {
                    btn.disabled = false;
                    btn.textContent = originalText;
                    console.error("Login fetch error:", err);
                    alert(`通信エラーが発生しました。\n詳細: ${err.message}\nCORS等の問題か、GAS側のエラーの可能性があります。`);
                });
        };

        window.submitUsername = function() {
            const usernameInput = document.getElementById('setup-username-input');
            if(!usernameInput) return;
            
            const username = usernameInput.value.trim();
            if(!username) {
                alert("ユーザー名を入力してください。");
                return;
            }
            if(username.length < 2 || username.length > 15) {
                alert("ユーザー名は2文字以上15文字以内で入力してください。");
                return;
            }
            if(containsBadWords(username)) {
                alert("ユーザー名に不適切な表現（卑猥・差別用語等）が含まれています。別の名前を入力してください。");
                return;
            }
            
            const email = window.getPremiumEmail();
            const pass = window.getPremiumPass();
            if(!email || !pass) {
                alert("セッションが切れました。再度ログインしてください。");
                window.closeUsernameModal();
                window.showLoginModal();
                return;
            }
            
            const btn = document.querySelector("#username-modal button");
            const originalText = btn.textContent;
            btn.disabled = true;
            btn.textContent = "登録中...";
            
            const updateUrl = `${GAS_API_URL}?action=update_username&email=${encodeURIComponent(email)}&pass=${encodeURIComponent(pass)}&username=${encodeURIComponent(username)}&t=${new Date().getTime()}`;
            
            fetch(updateUrl)
                .then(res => res.json())
                .then(res => {
                    btn.disabled = false;
                    btn.textContent = originalText;
                    if(res && res.success) {
                        localStorage.setItem('PREMIUM_USERNAME_KEY', res.username);
                        window.closeUsernameModal();
                        alert("ユーザー名を設定しました！");
                    } else {
                        alert(res.error || "ユーザー名の登録に失敗しました。");
                    }
                })
                .catch(err => {
                    btn.disabled = false;
                    btn.textContent = originalText;
                    console.error(err);
                    alert("通信エラーが発生しました。");
                });
        };
        
        function fetchLatestDataSilently() {
            const lastUpdate = document.getElementById('last-update');
            const dataContainer = document.getElementById('data-container');
            if(lastUpdate) lastUpdate.innerHTML = `<span class="text-indigo-400 animate-pulse font-bold">更新中...</span>`;
            if(dataContainer) {
                dataContainer.style.opacity = '0.4';
                dataContainer.style.pointerEvents = 'none';
                dataContainer.style.transition = 'opacity 0.2s ease';
            }
            
            getInitialPayload(
                function(payload) {
                    if(dataContainer) {
                        dataContainer.style.opacity = '1';
                        dataContainer.style.pointerEvents = 'auto';
                    }
                    if (payload && payload.success) {
                        window.activeVenues = payload.venues || [];
                        window.cutoffTimesMap = payload.cutoffTimes || {};
                        window.predictionsCache = payload.predictions || {};
                        
                        window.dailyDefenseFund = payload.daily_defense_fund || 0;
                        updateDefenseFundUI();
                        
                        checkPremiumStatusFromData(payload);
                        
                        // 現在選択されているレースデータを再ロード
                        loadDataLocal();
                        
                        if(lastUpdate) {
                            const now = new Date();
                            lastUpdate.textContent = now.getHours() + ":" + ("0" + now.getMinutes()).slice(-2) + ":" + ("0" + now.getSeconds()).slice(-2);
                        }
                    }
                },
                function(err) {
                    console.error("Re-fetch failed:", err);
                    if(dataContainer) {
                        dataContainer.style.opacity = '1';
                        dataContainer.style.pointerEvents = 'auto';
                    }
                    if(lastUpdate) lastUpdate.innerHTML = `<span class="text-rose-500 font-bold">更新失敗</span>`;
                }
            );
        }
        
        function checkPremiumStatusFromData(payload) {
            let isUnlocked = false;
            
            // ローカルの認証情報の有無を確認
            const pass = window.getPremiumPass();
            const email = window.getPremiumEmail();
            const hasLocalAuth = (!!pass && !!email);

            if (hasLocalAuth) {
                if (payload && payload.access === "denied") {
                    isUnlocked = false;
                } else {
                    isUnlocked = true;
                }
            } else if (payload) {
                if (payload.access === "granted" || payload.status === 200 || payload.is_premium === true) {
                    isUnlocked = true;
                    if (payload.username) {
                        localStorage.setItem('PREMIUM_USERNAME_KEY', payload.username);
                    }
                } else if (payload.predictions && Object.keys(payload.predictions).length > 0) {
                    const firstKey = Object.keys(payload.predictions)[0];
                    const pred = payload.predictions[firstKey];
                    if (pred && pred.predictions && pred.predictions.length > 0) {
                        isUnlocked = (pred.predictions[0].combo !== "🔒-🔒-🔒");
                    }
                }
            }
            
            updateLoginIcon(isUnlocked);
            return isUnlocked;
        }
        window.submitLogout = function() {
            if (confirm("ログアウトしますか？")) {
                localStorage.removeItem('PREMIUM_PASS_KEY');
                localStorage.removeItem('PREMIUM_EMAIL_KEY');
                localStorage.removeItem('PREMIUM_AUTH_TIME');
                localStorage.removeItem('PREMIUM_USERNAME_KEY');
                updateLoginIcon(false);
                fetchLatestDataSilently();
            }
        };

        function updateLoginIcon(forceUnlocked) {
            const pass = window.getPremiumPass();
            const email = window.getPremiumEmail();
            
            const isUnlocked = (typeof forceUnlocked === 'boolean') ? forceUnlocked : (!!pass && !!email);
            
            const icon = document.getElementById('header-login-icon');
            const text = document.getElementById('header-login-text');
            const btn = document.getElementById('header-login-btn');
            const footerArea = document.getElementById('footer-auth-area');
            
            if (isUnlocked) {
                if (icon) icon.textContent = "👑";
                if (text) {
                    if (email) {
                        const namePart = email.split('@')[0];
                        text.textContent = namePart.substring(0, 8) + (namePart.length > 8 ? "..." : "");
                    } else if (pass) {
                        text.textContent = pass.substring(0, 8);
                    } else {
                        text.textContent = "プレミアム";
                    }
                }
                if (btn) {
                    btn.className = "flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-gradient-to-r from-amber-500/20 to-yellow-500/20 border border-amber-500/30 text-amber-300 hover:from-amber-500/30 hover:to-yellow-500/30 transition-colors shadow-sm focus:outline-none text-[11px] font-bold cursor-pointer";
                    btn.onclick = function() { window.submitLogout(); };
                }
                
                // フッターエリア（ログイン中：ポータルリンク＋ログアウト）
                if (footerArea) {
                    // ※ Stripeカスタマーポータルの固定リンク
                    footerArea.innerHTML = `
                        <a href="https://billing.stripe.com/p/login/14A7sL9QicK66O54bdgjC00" target="_blank" class="block w-full py-2 bg-gradient-to-r from-amber-500 to-yellow-600 hover:from-amber-400 hover:to-yellow-500 text-white text-xs font-bold rounded-xl shadow-md transition-all text-center">
                            👑 契約内容の確認・解約
                        </a>
                        <button onclick="window.submitLogout()" class="block w-full py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold rounded-xl border border-white/5 transition-all cursor-pointer">
                            🔓 ログアウト
                        </button>
                    `;
                }
            } else {
                if (icon) icon.textContent = "🔑";
                if (text) text.textContent = "ログイン";
                if (btn) {
                    btn.className = "flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-800/80 border border-white/10 hover:bg-slate-700 transition-colors shadow-sm focus:outline-none text-[11px] font-bold text-slate-200 cursor-pointer";
                    btn.onclick = function() { window.showLoginModal(); };
                }
                
                // フッターエリア（未ログイン：プレミアム登録ボタンのみ）
                if (footerArea) {
                    footerArea.innerHTML = `
                        <a href="https://buy.stripe.com/eVq6oH9Qi39w3BT8rtgjC01" target="_blank" class="block w-full py-2.5 bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-400 hover:to-purple-500 text-white text-xs font-bold rounded-xl shadow-lg transition-all text-center">
                            👑 プレミアム登録 (月額500円)
                        </a>
                    `;
                }
            }
            
            // Update Premium Panel based on status
            if (!isUnlocked) {
                const snsPanel = document.getElementById('sns-panel');
                if (snsPanel) snsPanel.classList.add('hidden');
            }
            // \u30ed\u30b0\u30a4\u30f3\u6e08\u307f\u30e6\u30fc\u30b6\u30fc\u306b\u306f\u30d2\u30fc\u30ed\u30fc\u30bb\u30af\u30b7\u30e7\u30f3\uff08\u767b\u9332CTA\uff09\u3092\u975e\u8868\u793a
            const heroSection = document.getElementById('hero-section');
            if (heroSection) heroSection.style.display = isUnlocked ? 'none' : '';
        }
        window.renderNews = function(news) {
            const container = document.getElementById('news-list-container');
            if (!container) return;
            
            if (!news || !Array.isArray(news) || news.length === 0) {
                container.innerHTML = `
                    <li class="flex items-start gap-2">
                        <span class="px-1.5 py-0.5 rounded bg-emerald-900/60 text-[8px] text-emerald-300 font-mono tracking-tighter shrink-0 mt-0.5">2026/07/02</span>
                        <div>
                            📈 <span class="text-emerald-300 font-bold">【新機能】日次・月次収支実績を公開</span>しました。7/1以降の的中結果・回収率を日次グラフで確認できます（ページ下部「収支実績」をタップ）。
                        </div>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="px-1.5 py-0.5 rounded bg-emerald-900/60 text-[8px] text-emerald-300 font-mono tracking-tighter shrink-0 mt-0.5">2026/07/02</span>
                        <div>
                            🏊 <span class="text-emerald-300 font-bold">【新機能】選手名タップで詳細情報を表示</span>。展示マージ詳細データの選手名をタップすると、AIスコア・ST評価・勝率・モーター機力の内訳が確認できます。
                        </div>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="px-1.5 py-0.5 rounded bg-slate-700/80 text-[8px] text-slate-400 font-mono tracking-tighter shrink-0 mt-0.5">2026/07/01</span>
                        <div>
                            🛡️ <span class="text-rose-300 font-bold">【新機能】資金防衛AIマネージャー</span>を実装しました。Gemini 2.5 Flashによる冷徹な投資判断を表示します。
                        </div>
                    </li>
                `;
                return;
            }
            
            container.innerHTML = '';
            news.forEach(item => {
                const li = document.createElement('li');
                li.className = 'flex items-start gap-2';
                
                const badge = document.createElement('span');
                const badgeClass = item.badge_class || 'bg-slate-700/80 text-slate-400';
                badge.className = `px-1.5 py-0.5 rounded text-[8px] font-mono tracking-tighter shrink-0 mt-0.5 ${badgeClass}`;
                badge.textContent = item.date;
                
                const div = document.createElement('div');
                
                const titleSpan = document.createElement('span');
                titleSpan.className = 'text-emerald-300 font-bold';
                titleSpan.textContent = `【${item.category || 'お知らせ'}】${item.title || ''} `;
                
                const contentText = document.createTextNode(item.content || '');
                
                div.appendChild(titleSpan);
                div.appendChild(contentText);
                li.appendChild(badge);
                li.appendChild(div);
                container.appendChild(li);
            });
        }

        let currentSNSType = "prediction";
        window.switchSNSTab = function(type) {
            currentSNSType = type;
            const tabPred = document.getElementById('sns-tab-prediction');
            const tabAch = document.getElementById('sns-tab-achievement');
            const videoLabel = document.getElementById('sns-video-label');
            
            if (type === 'prediction') {
                if (tabPred) tabPred.className = "py-1.5 text-[10px] font-bold rounded-lg transition-all focus:outline-none bg-indigo-600/80 text-white shadow-sm border border-indigo-500/20";
                if (tabAch) tabAch.className = "py-1.5 text-[10px] font-bold rounded-lg transition-all focus:outline-none text-slate-400 hover:text-slate-200";
                if (videoLabel) videoLabel.textContent = "1. 注目予想ショート動画";
            } else {
                if (tabPred) tabPred.className = "py-1.5 text-[10px] font-bold rounded-lg transition-all focus:outline-none text-slate-400 hover:text-slate-200";
                if (tabAch) tabAch.className = "py-1.5 text-[10px] font-bold rounded-lg transition-all focus:outline-none bg-indigo-600/80 text-white shadow-sm border border-indigo-500/20";
                if (videoLabel) videoLabel.textContent = "1. 的中実績ショート動画";
            }
            fetchSNSAssets();
        };

        function fetchSNSAssets() {
            const pass = window.getPremiumPass();
            const email = window.getPremiumEmail();
            if (!pass || !email) return;
            
            const today = new Date();
            const dateStr = today.getFullYear() + ("0" + (today.getMonth() + 1)).slice(-2) + ("0" + today.getDate()).slice(-2);
            
            const url = `${GAS_API_URL}?action=get_sns_assets&date=${dateStr}&type=${currentSNSType}&t=${new Date().getTime()}`;
            
            fetch(url)
                .then(res => res.json())
                .then(res => {
                    const snsPanel = document.getElementById('sns-panel');
                    if (res && res.success && res.download_url) {
                        if (snsPanel) snsPanel.classList.remove('hidden');
                        
                        const snsDate = document.getElementById('sns-date');
                        if (snsDate) snsDate.textContent = res.date;
                        
                        const dlBtn = document.getElementById('sns-download-btn');
                        if (dlBtn) dlBtn.href = res.download_url;
                        
                        const textArea = document.getElementById('sns-text-area');
                        if (textArea) textArea.value = res.x_text || "";
                        
                        const shareBtn = document.getElementById('sns-share-btn');
                        if (shareBtn) {
                            shareBtn.href = `https://x.com/intent/tweet?text=${encodeURIComponent(res.x_text || "")}`;
                        }
                    } else {
                        // 朝と夜、片方のアセットがない場合はパネル全体を隠すのではなく、
                        // もしどちらか片方でもアセットがあればパネル自体は表示し続けたいので、
                        // ローカルでの表示を切り替えた際にアセットが空であれば、ダウンロードボタンやエリアを「準備中」にする
                        if (currentSNSType === "achievement") {
                            // 夜の実績がまだない場合
                            const dlBtn = document.getElementById('sns-download-btn');
                            if (dlBtn) dlBtn.removeAttribute('href');
                            const textArea = document.getElementById('sns-text-area');
                            if (textArea) textArea.value = "夜のレース終了後、的中結果動画と振り返りテキストが自動生成されます。お待ちください。";
                        } else {
                            // 朝の予想がまだない場合
                            const dlBtn = document.getElementById('sns-download-btn');
                            if (dlBtn) dlBtn.removeAttribute('href');
                            const textArea = document.getElementById('sns-text-area');
                            if (textArea) textArea.value = "朝の事前予想完了後、注目予想動画とX用下書きテキストが自動生成されます。お待ちください。";
                        }
                    }
                })
                .catch(err => {
                    console.error("SNS Assets load error:", err);
                });
        }
        
        window.copySNSText = function() {
            const textArea = document.getElementById('sns-text-area');
            if (textArea && textArea.value) {
                textArea.select();
                textArea.setSelectionRange(0, 99999);
                navigator.clipboard.writeText(textArea.value)
                    .then(() => {
                        alert("X投稿テキストをクリップボードにコピーしました！");
                    })
                    .catch(err => {
                        console.error("Copy failed:", err);
                    });
            }
        }

        document.addEventListener('DOMContentLoaded', () => updateLoginIcon());

        // ============================================================
        // ★ 選手詳細モーダル
        // ============================================================
        window.showRacerDetailModal = function(r, aiScore) {
            const modal = document.getElementById('racer-detail-modal');
            const lane = parseInt(r.lane) || 1;
            const winRate = parseFloat(r.rate) || 0;
            const motorRate = parseFloat(r.motor_rate) || 0;
            const exTime = r.ex_time || '--';
            const tilt = r.tilt || '--';
            const cls = r.cls || '';
            const stValRaw = r.st_val || '';
            const stVal = parseFloat(stValRaw);

            // バッジ色
            document.getElementById('rdm-badge').className = `w-10 h-10 rounded-xl flex items-center justify-center font-black text-xl shadow-md boat-${lane}`;
            document.getElementById('rdm-badge').textContent = lane;
            document.getElementById('rdm-name').textContent = r.name || `${lane}号艇`;
            document.getElementById('rdm-class').textContent = `${cls} | ${r.st_course || lane}コース進入`;

            // AIスコアバッジ
            const scoreEl = document.getElementById('rdm-ai-score');
            const scoreClass = aiScore >= 70 ? 'text-emerald-400 bg-emerald-500/10 border-emerald-500/30'
                : aiScore >= 50 ? 'text-amber-400 bg-amber-500/10 border-amber-500/30'
                : 'text-slate-400 bg-slate-800/50 border-slate-700/30';
            scoreEl.className = `px-3 py-1.5 rounded-xl border text-base font-black ${scoreClass}`;
            scoreEl.textContent = `AI ${aiScore}`;

            // 数値
            document.getElementById('rdm-rate').textContent = `${winRate.toFixed(2)}`;
            document.getElementById('rdm-motor').textContent = `${motorRate.toFixed(1)}%`;
            document.getElementById('rdm-ex-time').textContent = (exTime === 'N/A' || exTime === '') ? '--' : exTime;
            document.getElementById('rdm-tilt').textContent = `${tilt} / ${r.st_course || lane}コース`;

            // スタート評価
            let stEval = '--';
            if (!isNaN(stVal)) {
                if (stVal <= 0.12) stEval = `⚡ 超フライング警戒 ST${stVal.toFixed(2)}`;
                else if (stVal <= 0.16) stEval = `🟢 アーリー ST${stVal.toFixed(2)}`;
                else if (stVal <= 0.19) stEval = `🟡 標準 ST${stVal.toFixed(2)}`;
                else stEval = `🔴 スロー ST${stVal.toFixed(2)}`;
            }
            document.getElementById('rdm-start').textContent = stEval;

            // AIスコア内訳
            const rateContrib = Math.round(winRate * 8);
            const motorContrib = Math.round(motorRate * 0.3);
            const timeContrib = aiScore - rateContrib - motorContrib;
            document.getElementById('rdm-ai-breakdown').innerHTML =
                `勝率貢献: <strong class="text-white">+${rateContrib}</strong> (${winRate.toFixed(2)} × 8)<br>` +
                `機力貢献: <strong class="text-white">+${motorContrib}</strong> (${motorRate.toFixed(1)}% × 0.3)<br>` +
                `展示補正: <strong class="text-white">${timeContrib >= 0 ? '+' : ''}${timeContrib}</strong> (展示タイム偏差)`;

            // ============================
            // パワプロ風 能力グレード計算
            // ============================
            function calcGrade(value, thresholds) {
                // thresholds: [S, A, B, C, D] 降順
                if (value >= thresholds[0]) return 'S';
                if (value >= thresholds[1]) return 'A';
                if (value >= thresholds[2]) return 'B';
                if (value >= thresholds[3]) return 'C';
                if (value >= thresholds[4]) return 'D';
                return 'E';
            }

            const gradeConfig = {
                color: { S: '#f59e0b', A: '#ef4444', B: '#f97316', C: '#22c55e', D: '#06b6d4', E: '#6b7280' },
                bg:    { S: 'rgba(245,158,11,0.15)', A: 'rgba(239,68,68,0.12)', B: 'rgba(249,115,22,0.12)', C: 'rgba(34,197,94,0.10)', D: 'rgba(6,182,212,0.10)', E: 'rgba(107,114,128,0.08)' },
            };

            // 全登録選手キャッシュ (window.racerScoreCache) から相対パーセンタイル値を参照
            const regNo = String(r.regNo || '').trim();
            const cachedScore = window.racerScoreCache && window.racerScoreCache[regNo] ? window.racerScoreCache[regNo] : null;

            // 展示タイム偏差スコア (exScore: 0-100) を計算
            let exScore = 50;
            const exFloat = parseFloat(exTime);
            if (!isNaN(exFloat) && typeof allRacers !== 'undefined' && allRacers && allRacers.length > 0) {
                const times = allRacers.map(rx => parseFloat(rx.ex_time)).filter(t => !isNaN(t));
                if (times.length > 0) {
                    const minT = Math.min(...times);
                    const maxT = Math.max(...times);
                    const range = maxT - minT || 0.01;
                    exScore = Math.round(100 - ((exFloat - minT) / range) * 90);
                }
            } else if (!isNaN(exFloat)) {
                exScore = Math.min(100, Math.max(0, Math.round(((6.95 - exFloat) / (6.95 - 6.55)) * 100)));
            }

            let winScore, startScore, escapeScore, turnScore, maintScore, safetyScore, classScore;

            if (cachedScore) {
                // 全登録選手の中での相対パーセンタイル (0-100)
                winScore    = cachedScore.win;
                startScore  = cachedScore.start;
                escapeScore = cachedScore.escape;
                turnScore   = cachedScore.turn;
                safetyScore = cachedScore.safety;
                classScore  = cachedScore.clsSc;

                // 整備・調整力 = (整備ベース * 0.4) + (本日の展示タイムスコア * 0.4) + (本日のモーター2連率補正 * 0.2)
                const motorBonus = Math.min(100, Math.max(0, (motorRate - 20) / (60 - 20) * 100)); // 20%-60%を0-100化
                maintScore = Math.round(cachedScore.maint * 0.4 + exScore * 0.4 + motorBonus * 0.2);
                maintScore = Math.min(100, Math.max(0, maintScore));
            } else {
                // フォールバック: データがない場合は既存の絶対評価ロジック
                winScore = Math.min(100, Math.max(0, ((winRate - 3.0) / (8.0 - 3.0)) * 100));
                const motorScore = Math.min(100, Math.max(0, ((motorRate - 20) / (65 - 20)) * 100));
                
                startScore = 50;
                if (!isNaN(stVal)) {
                    if (stVal <= 0.13) startScore = 95;
                    else if (stVal <= 0.16) startScore = 82;
                    else if (stVal <= 0.18) startScore = 65;
                    else if (stVal <= 0.21) startScore = 45;
                    else startScore = 25;
                }
                const clsMap = { 'A1': 100, 'A2': 68, 'B1': 36, 'B2': 10 };
                classScore = clsMap[cls] || 36;

                // フォールバック用のダミー値
                escapeScore = (r.st_course === '1' || lane === 1) ? 80 : 30;
                turnScore   = motorScore;
                maintScore  = Math.round(motorScore * 0.5 + exScore * 0.5);
                safetyScore = 75; // F/Lが不明なので安全評価中央
            }

            const fCount = parseInt(r.f_count) || 0;
            const lCount = parseInt(r.l_count) || 0;

            const abilities = [
                { label: '勝率（走力）', score: winScore,    raw: `${winRate.toFixed(2)}`,       grade: calcGrade(winScore,    [88,72,55,38,22]) },
                { label: 'スタート',   score: startScore,  raw: `${stValRaw ? stValRaw : '--'}s`, grade: calcGrade(startScore,  [88,72,55,38,22]) },
                { label: '旋回・捌き', score: turnScore,   raw: cachedScore ? `${turnScore}%` : '--', grade: calcGrade(turnScore,   [88,72,55,38,22]) },
                { label: '整備・調整', score: maintScore,  raw: `${maintScore}%`,               grade: calcGrade(maintScore,  [88,72,55,38,22]) },
                { label: 'イン逃げ率', score: escapeScore, raw: cachedScore ? `${escapeScore}%` : '--', grade: calcGrade(escapeScore, [88,72,55,38,22]) },
                { label: '安定感',     score: safetyScore, raw: `今期F${fCount}/L${lCount}`,     grade: calcGrade(safetyScore, [88,72,55,38,22]) },
            ];

            // グレードバー描画
            const barsEl = document.getElementById('rdm-grade-bars');
            barsEl.innerHTML = '';
            abilities.forEach(ab => {
                const g = ab.grade;
                const col = gradeConfig.color[g];
                const bg = gradeConfig.bg[g];
                const barWidth = Math.round(ab.score);
                barsEl.innerHTML += `
                    <div class="flex items-center gap-2">
                        <div class="text-[10px] font-bold text-slate-400 w-16 flex-shrink-0">${ab.label}</div>
                        <div class="flex-1 h-4 rounded-md overflow-hidden" style="background:rgba(255,255,255,0.04);">
                            <div class="h-full rounded-md flex items-center pl-1.5 transition-all duration-700" style="width:${barWidth}%;background:${col};opacity:0.85;">
                                <span class="text-[8px] font-black text-white/90 leading-none">${g}</span>
                            </div>
                        </div>
                        <div class="text-[9px] font-mono font-bold text-slate-500 w-16 text-right flex-shrink-0">${ab.raw}</div>
                        <div class="w-6 h-6 rounded-md flex items-center justify-center text-xs font-black flex-shrink-0" style="background:${bg};color:${col};border:1px solid ${col}44;">${g}</div>
                    </div>
                `;
            });

            // 特殊能力（青特・赤特・金特）の判定と描画
            const specEl = document.getElementById('rdm-special-abilities');
            specEl.innerHTML = '';
            const specList = [];

            // 金特判定 (Gold - 90%以上かつ特定条件)
            if (escapeScore >= 90) {
                specList.push({ name: 'インの鬼', type: 'gold', desc: '1コース進入時の逃げ率が驚異的' });
            }
            if (startScore >= 90 && stVal <= 0.13) {
                specList.push({ name: '電撃スタート', type: 'gold', desc: 'スタートタイミングの早さと安定性が抜群' });
            }

            // 青特判定 (Blue - 75%以上かつ好条件)
            if (turnScore >= 75) {
                specList.push({ name: '精密旋回', type: 'blue', desc: 'イン以外のコースからでも的確に着に絡む旋回力' });
            }
            if (maintScore >= 80) {
                specList.push({ name: '名整備士', type: 'blue', desc: '機力調整・気象に合わせた整備能力が高い' });
            }
            if (fCount === 0 && lCount === 0) {
                specList.push({ name: '鉄壁（事故無）', type: 'blue', desc: '今期フライング・出遅れが一切なく抜群の安定感' });
            }
            if (motorRate >= 40) {
                specList.push({ name: '快速モーター', type: 'blue', desc: '好調なモーターを引き当てている' });
            }
            if (stVal > 0 && stVal <= 0.14) {
                specList.push({ name: 'スタート速攻', type: 'blue', desc: '直前展示で鋭いスタートダッシュを見せている' });
            }

            // 赤特判定 (Red - ペナルティ)
            if (fCount >= 2) {
                specList.push({ name: '危険信号', type: 'red', desc: '今期フライング2回以上。極度のスタート控え懸念' });
            } else if (fCount === 1) {
                specList.push({ name: 'F持ち', type: 'red', desc: '今期フライング1回あり。スタート勝負で慎重になる可能性' });
            }
            if (lCount >= 1) {
                specList.push({ name: '出遅れ癖', type: 'red', desc: '今期スタート出遅れ（L）経験あり' });
            }

            if (specList.length === 0) {
                specEl.innerHTML = '<span class="text-[9px] text-slate-600 font-bold block w-full text-center py-1">なし</span>';
            } else {
                specList.forEach(sp => {
                    let cls = 'bg-blue-500/10 text-blue-400 border border-blue-500/20';
                    if (sp.type === 'gold') {
                        cls = 'bg-amber-500/20 text-amber-300 border border-amber-500/40 font-extrabold animate-pulse';
                    } else if (sp.type === 'red') {
                        cls = 'bg-rose-500/10 text-rose-400 border border-rose-500/20 font-bold';
                    }
                    specEl.innerHTML += `
                        <span class="px-2 py-0.5 rounded-md text-[9px] font-black cursor-help whitespace-nowrap ${cls}" title="${sp.desc}">${sp.name}</span>
                    `;
                });
            }

            // レーダーチャート描画
            if (window._rdmRadarChart) { window._rdmRadarChart.destroy(); }
            const ctx = document.getElementById('rdm-radar-chart').getContext('2d');
            window._rdmRadarChart = new Chart(ctx, {
                type: 'radar',
                data: {
                    labels: abilities.map(a => a.label),
                    datasets: [{
                        label: r.name || `${lane}号艇`,
                        data: abilities.map(a => a.score),
                        backgroundColor: `rgba(${lane===1?'239,68,68':lane===2?'30,41,59':lane===3?'239,68,68':lane===4?'59,130,246':lane===5?'234,179,8':'16,185,129'},0.15)`,
                        borderColor: `hsl(${[350,220,0,210,45,160][lane-1]},75%,60%)`,
                        borderWidth: 2,
                        pointBackgroundColor: `hsl(${[350,220,0,210,45,160][lane-1]},75%,65%)`,
                        pointRadius: 3,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: { duration: 600, easing: 'easeOutQuart' },
                    scales: {
                        r: {
                            min: 0, max: 100, ticks: { stepSize: 25, display: false },
                            grid: { color: 'rgba(255,255,255,0.06)' },
                            angleLines: { color: 'rgba(255,255,255,0.06)' },
                            pointLabels: { color: '#94a3b8', font: { size: 10, weight: 'bold' } }
                        }
                    },
                    plugins: { legend: { display: false } }
                }
            });

            modal.classList.remove('hidden');
        };

        // ============================================================
        // ★ 収支実績セクション (ROI History)
        // ============================================================
        (function initROIHistory() {
            const toggleBtn = document.getElementById('toggle-roi-btn');
            const container = document.getElementById('roi-container');
            const arrow = document.getElementById('roi-arrow');
            let roiChartInstance = null;
            let loaded = false;

            if (toggleBtn) {
                toggleBtn.addEventListener('click', () => {
                    const isHidden = container.classList.contains('hidden');
                    if (isHidden) {
                        container.classList.remove('hidden');
                        arrow.style.transform = 'rotate(180deg)';
                        if (!loaded) { loadROIHistory(); loaded = true; }
                    } else {
                        container.classList.add('hidden');
                        arrow.style.transform = 'rotate(0deg)';
                    }
                });
            }

            // ページロード時に最初から開いている状態であるため、自動的にロードを実行する
            if (document.readyState === 'loading') {
                window.addEventListener('DOMContentLoaded', () => {
                    if (!loaded) {
                        loadROIHistory();
                        loaded = true;
                    }
                });
            } else {
                if (!loaded) {
                    loadROIHistory();
                    loaded = true;
                }
            }

            const STATIC_HISTORY_FALLBACK = [
                {
                    date: "20260701",
                    invest: 168000,
                    payout: 201300,
                    balance: 33300,
                    roi: 119.8,
                    hits: 18,
                    races: 168,
                    solid_roi: 130.8,
                    upset_roi: 115.4
                }
            ];

            function loadROIHistory() {
                renderROIHistory(STATIC_HISTORY_FALLBACK);

                console.log('Fetching latest ROI history from GAS...');
                fetch(`${GAS_API_URL}?action=get_roi_history&from=20260701`)
                    .then(r => r.json())
                    .then(data => {
                        if (data.success && data.history && data.history.length > 0) {
                            renderROIHistory(data.history);
                        }
                    })
                    .catch(err => {
                        console.warn('Failed to fetch ROI history from GAS, using fallback.', err);
                        renderROIHistory(STATIC_HISTORY_FALLBACK);
                    });
            }

            function showROIFallback() {
                // fallback to static history instead of showing empty state
                renderROIHistory(STATIC_HISTORY_FALLBACK);
            }

            function renderROIHistory(history) {
                // history: [{date, balance, roi, hits, invest, payout}, ...]
                // ソート（日付昇順） - 念のため文字列化してから比較
                history.sort((a, b) => String(a.date).localeCompare(String(b.date)));
                const filter2026 = history.filter(d => String(d.date) >= '20260701');

                // 月次集計
                const totalBalance = filter2026.reduce((s, d) => s + (d.balance || 0), 0);
                const totalInvest = filter2026.reduce((s, d) => s + (d.invest || 0), 0);
                const totalPayout = filter2026.reduce((s, d) => s + (d.payout || 0), 0);
                const totalHits = filter2026.reduce((s, d) => s + (d.hits || 0), 0);
                const monthlyROI = totalInvest > 0 ? (totalPayout / totalInvest * 100).toFixed(1) : '--';

                const balEl = document.getElementById('roi-monthly-balance');
                balEl.textContent = `${totalBalance >= 0 ? '+' : ''}${totalBalance.toLocaleString()}円`;
                balEl.className = `text-sm font-black font-outfit ${totalBalance >= 0 ? 'text-emerald-400' : 'text-rose-400'}`;
                document.getElementById('roi-monthly-roi').textContent = `${monthlyROI}%`;
                document.getElementById('roi-monthly-hits').textContent = `${totalHits}R`;

                // Chart.js 棒グラフ
                const labels = filter2026.map(d => {
                    const s = d.date.toString();
                    return `${s.slice(4,6)}/${s.slice(6,8)}`;
                });
                const balances = filter2026.map(d => d.balance || 0);
                const bgColors = balances.map(b => b >= 0 ? 'rgba(16,185,129,0.7)' : 'rgba(239,68,68,0.7)');
                const borderColors = balances.map(b => b >= 0 ? 'rgb(16,185,129)' : 'rgb(239,68,68)');

                if (typeof Chart !== 'undefined') {
                    const ctx = document.getElementById('roi-bar-chart').getContext('2d');
                    if (roiChartInstance) roiChartInstance.destroy();
                    roiChartInstance = new Chart(ctx, {
                        type: 'bar',
                        data: {
                            labels,
                            datasets: [{
                                label: '日次収支(円)',
                                data: balances,
                                backgroundColor: bgColors,
                                borderColor: borderColors,
                                borderWidth: 1,
                                borderRadius: 4,
                            }]
                        },
                        options: {
                            responsive: true,
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        label: ctx => `${ctx.parsed.y >= 0 ? '+' : ''}${ctx.parsed.y.toLocaleString()}円`
                                    }
                                }
                            },
                            scales: {
                                x: { ticks: { color: '#94a3b8', font: { size: 9 } }, grid: { color: 'rgba(255,255,255,0.04)' } },
                                y: { ticks: { color: '#94a3b8', font: { size: 9 }, callback: v => `${v >= 0 ? '+' : ''}${v.toLocaleString()}` }, grid: { color: 'rgba(255,255,255,0.06)' }, border: { color: 'transparent' } }
                            }
                        }
                    });
                } else {
                    console.warn("Chart.js is not defined. Skipping bar chart rendering.");
                    const canvas = document.getElementById('roi-bar-chart');
                    if (canvas) {
                        canvas.style.display = 'none';
                        const parent = canvas.parentElement;
                        if (parent && !document.getElementById('roi-chart-error-msg')) {
                            const errEl = document.createElement('div');
                            errEl.id = 'roi-chart-error-msg';
                            errEl.className = 'text-[10px] text-slate-500 text-center py-6 border border-white/5 rounded-xl bg-slate-900/30';
                            errEl.innerText = "📊 グラフ描画ライブラリをロードできませんでした（オフライン表示中）";
                            parent.appendChild(errEl);
                        }
                    }
                }

                // 日次一覧
                const listEl = document.getElementById('roi-daily-list');
                if (filter2026.length === 0) {
                    listEl.innerHTML = '<div class="text-center py-4 text-[10px] text-slate-500">7月1日以降のデータがまだありません。</div>';
                    return;
                }
                listEl.innerHTML = [...filter2026].reverse().map(d => {
                    const dateStr = d.date.toString();
                    const label = `${dateStr.slice(4,6)}/${dateStr.slice(6,8)}`;
                    const bal = d.balance || 0;
                    const roi = d.roi != null ? d.roi.toFixed(1) : '--';
                    const hits = d.hits || 0;
                    const balColor = bal >= 0 ? 'text-emerald-400' : 'text-rose-400';
                    return `<div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-950/40 border border-white/5">
                        <div class="flex items-center gap-2">
                            <span class="text-[9px] font-bold text-slate-400 w-12">${label}</span>
                            <span class="text-[8px] text-slate-500">的中 ${hits}R</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="text-[9px] font-bold text-slate-400">ROI ${roi}%</span>
                            <span class="text-xs font-black ${balColor}">${bal >= 0 ? '+' : ''}${bal.toLocaleString()}円</span>
                        </div>
                    </div>`;
                }).join('');
            }
        })();

        // ============================================================
        // ★ showTermsModal に「会員登録の解除」タブを追加
        // ============================================================
        const _origShowTermsModal = window.showTermsModal;
        window.showTermsModal = function(tab) {
            if (tab === 'withdraw') {
                // 退会モーダルを独自表示
                const existing = document.getElementById('withdraw-modal');
                if (existing) { existing.classList.remove('hidden'); return; }
                const m = document.createElement('div');
                m.id = 'withdraw-modal';
                m.className = 'fixed inset-0 z-[600] flex items-center justify-center p-4';
                m.innerHTML = `
                    <div class="absolute inset-0 bg-black/80 backdrop-blur-sm" onclick="document.getElementById('withdraw-modal').classList.add('hidden')"></div>
                    <div class="relative w-full max-w-sm bg-slate-900 rounded-2xl border border-white/10 shadow-2xl p-5 space-y-4 z-10">
                        <h2 class="text-sm font-black text-white">会員登録の解除</h2>
                        <p class="text-[10px] text-slate-400 leading-relaxed">
                            サブスクリプションの解約は、Stripeのカスタマーポータルから手続きできます。<br><br>
                            解約後も当月末まではサービスを継続してご利用いただけます。<br>
                            データやアカウントに関するお問い合わせは、プロフィールのXアカウントよりDMでご連絡ください。
                        </p>
                        <a href="https://billing.stripe.com/p/login/14A7sL9QicK66O54bdgjC00" target="_blank"
                           class="block w-full py-2.5 bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs rounded-xl text-center transition-colors">
                            Stripeポータルで解約手続きをする
                        </a>
                        <button onclick="document.getElementById('withdraw-modal').classList.add('hidden')"
                                class="w-full py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-xs rounded-xl border border-white/5 transition-colors">
                            閉じる
                        </button>
                    </div>`;
                document.body.appendChild(m);
                return;
            }
            if (typeof _origShowTermsModal === 'function') _origShowTermsModal(tab);
        };

        // モーダルのスライドアップアニメーション
        const styleEl = document.createElement('style');
        styleEl.textContent = `@keyframes slideUp { from { transform: translateY(100%); opacity: 0; } to { transform: translateY(0); opacity: 1; } } .animate-slide-up { animation: slideUp 0.25s ease-out; }`;
        document.head.appendChild(styleEl);

    </script>
</body>
</html>
